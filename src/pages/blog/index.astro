---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';
import { publishedBlogPosts } from '../../data/blogPosts';

const badgeStyles = {
  amber: 'bg-amber-100 text-amber-900 border-amber-200',
  blue: 'bg-blue-100 text-blue-900 border-blue-200',
  emerald: 'bg-emerald-100 text-emerald-900 border-emerald-200',
  indigo: 'bg-indigo-100 text-indigo-900 border-indigo-200',
};
---

<Layout
  title="Blog y Guías sobre Certificado Digital, Firma PDF y Normativa AEAT"
  description="Guías prácticas para autónomos, pymes y ciudadanos en España: normativa VeriFactu, facturas electrónicas, errores de AutoFirma, DNIe y trámites en sedes electrónicas."
  canonicalPath="/blog/"
>
  <!-- Hero Header -->
  <header class="py-12 bg-gradient-to-b from-slate-900 to-slate-800 text-white border-b border-slate-700">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-500/20 border border-blue-400/30 text-blue-300 rounded-full text-xs font-semibold mb-4">
        <span>📚</span> Centro de Recursos Jurídicos y Técnicos · España
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
        Guías de Firma Digital, Certificados FNMT y Cumplimiento Fiscal
      </h1>
      <p class="text-sm sm:text-base text-slate-300 mt-3 max-w-2xl mx-auto leading-relaxed">
        Tutoriales paso a paso verificados conforme al Reglamento eIDAS (UE) 910/2014, Ley 6/2020 y normativa de facturación de la Agencia Tributaria (AEAT).
      </p>
    </div>
  </header>

  <!-- Articles Grid -->
  <section class="py-12 bg-slate-50 min-h-[50vh]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {publishedBlogPosts.map((post) => (
          <article class="bg-white border border-slate-200 rounded-2xl p-6 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${badgeStyles[post.badgeColor]}`}>
                  {post.category}
                </span>
                <span class="text-xs text-slate-400 font-medium">{post.readTime}</span>
              </div>

              <h2 class="text-lg font-extrabold text-slate-900 leading-snug hover:text-blue-600 transition-colors">
                <a href={`/blog/${post.slug}/`}>
                  {post.title}
                </a>
              </h2>

              <p class="text-xs sm:text-sm text-slate-600 mt-2.5 leading-relaxed">
                {post.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-400">Actualizado: {post.updatedDate}</span>
              <a
                href={`/blog/${post.slug}/`}
                class="font-bold text-blue-600 hover:text-blue-800 inline-flex items-center gap-1"
              >
                Leer guía completa &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Bottom Tool CTA Banner -->
      <div class="mt-12 bg-blue-900 text-white rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md">
        <div class="space-y-1 text-center sm:text-left">
          <h3 class="text-lg sm:text-xl font-bold">¿Necesitas firmar un PDF con tu certificado digital ahora mismo?</h3>
          <p class="text-xs sm:text-sm text-blue-200">
            Firma en 3 segundos desde tu navegador sin instalar AutoFirma ni Java. 100% privado en tu dispositivo.
          </p>
        </div>
        <a
          href="/"
          class="px-6 py-3 bg-white hover:bg-blue-50 text-blue-950 font-extrabold text-xs sm:text-sm rounded-xl shadow shrink-0 transition-colors"
        >
          ✍️ Abrir Firmador de PDF Gratis &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
