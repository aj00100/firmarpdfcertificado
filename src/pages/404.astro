---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Error 404 — Página No Encontrada"
  description="La página que buscas no existe o ha cambiado de dirección. Vuelve al firmador de PDF con certificado digital."
  noindex={true}
>
  <section class="py-20 bg-white text-center">
    <div class="max-w-xl mx-auto px-4 sm:px-6 space-y-6">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-blue-100 text-blue-700 text-3xl font-extrabold">
        404
      </div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
        Página no encontrada
      </h1>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        La dirección web a la que has intentado acceder no existe o ha sido movida. Puedes utilizar directamente nuestras herramientas principales de firma y verificación:
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="px-5 py-3 bg-blue-600 hover:bg-blue-700 text-white text-xs sm:text-sm font-bold rounded-xl shadow-sm transition-colors"
        >
          ✍️ Ir al Firmador de PDF Gratis
        </a>
        <a
          href="/validar-firma-digital-pdf/"
          class="px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs sm:text-sm font-bold rounded-xl transition-colors"
        >
          🔍 Validar Firma de un PDF
        </a>
        <a
          href="/blog/"
          class="px-5 py-3 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs sm:text-sm font-bold rounded-xl transition-colors"
        >
          📚 Ver Guías y Trámites
        </a>
      </div>
    </div>
  </section>
</Layout>
