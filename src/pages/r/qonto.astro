---
// src/pages/r/qonto.astro
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content="0; url=https://qonto.com/es" />
    <title>Redirigiendo a Qonto...</title>
    <script>
      window.location.replace("https://qonto.com/es");
    </script>
  </head>
  <body class="bg-slate-50 flex items-center justify-center min-h-screen text-slate-700 font-sans text-sm">
    <div class="text-center p-6 bg-white rounded-xl border border-slate-200 shadow-sm max-w-sm">
      <div class="text-3xl mb-3">⏳</div>
      <p class="font-bold text-slate-900">Redirigiendo a Qonto (Banca Empresas + Facturación)...</p>
      <p class="text-xs text-slate-500 mt-2">
        Si no se abre automáticamente, <a href="https://qonto.com/es" class="text-blue-600 underline font-semibold">haz clic aquí</a>.
      </p>
    </div>
  </body>
</html>
