---
// src/pages/quitar-firma-digital-pdf.astro
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    q: "¿Por qué quitar o eliminar una firma digital de un archivo PDF?",
    a: "Cuando un documento PDF se firma digitalmente bajo el estándar PAdES, el archivo activa internamente indicadores de protección criptográfica (/SigFlags 3) que bloquean la edición de textos y campos de formulario. Si necesitas corregir un error tipográfico en una cláusula, rellenar una casilla olvidada, recolocar un sello visual que tapa información importante o cambiar el certificado digital utilizado, es imprescindible eliminar los diccionarios de firma antiguos para devolver el PDF a su estado original editable."
  },
  {
    q: "¿Por qué iLovePDF, Smallpdf o los editores tradicionales no pueden borrar firmas digitales?",
    a: "La mayoría de herramientas web convencionales tratan las firmas como meras imágenes superpuestas. Al encontrarse con una firma criptográfica real incrustada en el árbol de objetos del catálogo (/AcroForm -> /Fields con widgets /Sig), no pueden modificarla sin corromper la estructura interna del archivo. Algunas herramientas recurren a 'imprimir como imagen', lo que destruye la nitidez tipográfica, elimina la selección de texto OCR y aumenta exponencialmente el peso del archivo. Nuestro motor inspecciona el árbol binario con pdf-lib y retira con precisión quirúrgica únicamente los nodos /Sig sin perder calidad vectorial."
  },
  {
    q: "¿Es legal eliminar una firma digital de un documento PDF?",
    a: "Sí, es completamente legal siempre que actúes sobre tus propios documentos, borradores o contratos en fase de negociación antes de su elevación o presentación definitiva. Al eliminar la firma digital, el documento pierde su certificación y pasa a ser un borrador sin certificar. Nunca se produce una falsificación, ya que el documento resultante queda sin firma oficial hasta que se vuelva a firmar válidamente con el certificado correspondiente."
  },
  {
    q: "¿Mis documentos confidenciales se suben a algún servidor en internet?",
    a: "Bajo ninguna circunstancia. La eliminación de firmas digitales y el desbloqueo del archivo se realizan al 100% dentro de la memoria RAM de tu navegador mediante JavaScript y WebAssembly. Ni el texto del documento, ni tus datos personales abandonan jamás tu ordenador o teléfono móvil, garantizando el cumplimiento estricto del RGPD."
  },
  {
    q: "¿Qué ocurre con los sellos visuales (rúbricas) colocados en las páginas del PDF?",
    a: "Al procesar el documento con nuestra herramienta, las anotaciones visuales vinculadas al campo de firma (/Widget) se retiran limpiamente de la página, dejando el espacio en blanco original para que puedas estampar un nuevo sello en la posición correcta."
  },
  {
    q: "¿Cómo vuelvo a firmar el documento una vez corregido el texto?",
    a: "Una vez descargado el PDF desbloqueado, puedes editarlo con cualquier lector o editor de PDF. Cuando esté listo con los datos correctos, accede a nuestro firmador principal gratuito (FirmarPDFCertificado.com), arrastra el PDF y aplica tu certificado digital FNMT o DNIe con un solo clic."
  }
];
---

<Layout
  title="Quitar Firma Digital de un PDF Online Gratis — Desbloquear PDF Firmado"
  description="Elimina firmas digitales PAdES y sellos criptográficos de cualquier archivo PDF gratis en tu navegador. Desbloquea documentos firmados por error para editarlos y volver a firmar."
  canonicalPath="/quitar-firma-digital-pdf/"
>
  <!-- Hero Section -->
  <header class="py-12 bg-gradient-to-b from-amber-50/70 to-transparent border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-100 text-amber-900 rounded-full text-xs font-semibold mb-4">
        <span>🔓</span> Limpiador de Diccionarios /Sig y Desbloqueo de AcroForm
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Quitar Firma Digital de un PDF Online Gratis
      </h1>
      <p class="text-base sm:text-lg text-slate-600 mt-3 max-w-2xl mx-auto">
        ¿Has firmado un PDF con el certificado equivocado, el sello ha tapado texto o necesitas corregir un dato bloqueado? <strong>Elimina las firmas criptográficas y sellos visuales</strong> en 1 clic sin subir el archivo a ningún servidor.
      </p>
    </div>
  </header>

  <!-- Interactive Signature Remover Studio -->
  <section class="py-10 bg-slate-50 border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-white border border-slate-200 rounded-2xl shadow-lg overflow-hidden">
        <div class="bg-slate-900 text-white px-6 py-4 flex flex-wrap items-center justify-between gap-2">
          <div>
            <h2 class="text-lg font-bold tracking-tight flex items-center gap-2">
              <span>🧹</span> Desbloqueador y Eliminador de Firmas PDF
            </h2>
            <p class="text-xs text-slate-300 mt-0.5">
              Elimina anotaciones criptográficas (<code>/FT /Sig</code>) y sellos administrativos manteniendo intacto el texto y diseño original.
            </p>
          </div>
          <span class="text-xs bg-amber-950 border border-amber-700 text-amber-300 px-3 py-1 rounded-full font-medium">
            Procesamiento 100% Local en RAM
          </span>
        </div>

        <div class="p-6 md:p-8 space-y-6">
          <label
            id="rm-pdf-dropzone"
            for="rm-pdf-input"
            class="group flex flex-col items-center justify-center p-8 border-2 border-dashed border-slate-300 hover:border-amber-600 rounded-xl bg-slate-50/70 hover:bg-amber-50/40 cursor-pointer transition-all text-center min-h-[180px]"
          >
            <input id="rm-pdf-input" type="file" accept="application/pdf,.pdf" class="sr-only" />
            <div class="w-14 h-14 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center text-3xl mb-3 group-hover:scale-105 transition-transform">
              🔓
            </div>
            <span class="text-base font-bold text-slate-800" id="rm-pdf-title">
              Selecciona o arrastra aquí el PDF firmado que deseas desbloquear
            </span>
            <span class="text-xs text-slate-500 mt-1 max-w-lg" id="rm-pdf-sub">
              Se eliminarán todas las firmas digitales y sellos visuales para que puedas editarlo o firmarlo de nuevo sin bloqueos.
            </span>
            <span class="mt-4 inline-flex items-center px-5 py-2.5 bg-amber-700 group-hover:bg-amber-800 text-white text-xs font-bold rounded-lg shadow-xs transition-colors">
              Quitar Firmas Digitales y Desbloquear PDF →
            </span>
          </label>

          <div id="rm-status-box" class="hidden rounded-xl p-4 text-sm font-medium"></div>

          <div id="rm-result-box" class="hidden space-y-4">
            <div class="bg-emerald-50 border border-emerald-300 rounded-xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="space-y-1 text-center sm:text-left">
                <h3 class="text-base font-bold text-emerald-900" id="rm-result-title">
                  ✅ ¡Firmas Digitales Eliminadas con Éxito!
                </h3>
                <p class="text-xs text-emerald-800" id="rm-result-desc"></p>
              </div>
              <a
                id="rm-download-btn"
                href="#"
                download="Documento_Sin_Firma.pdf"
                class="w-full sm:w-auto text-center px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow-md transition-colors shrink-0"
              >
                ⬇️ Descargar PDF Limpio
              </a>
            </div>

            <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div>
                <p class="text-sm font-bold text-slate-800">¿Listo para volver a firmar el documento corregido?</p>
                <p class="text-xs text-slate-600">Elige la nueva posición del sello y aplica tu certificado digital FNMT o DNIe en 1 clic.</p>
              </div>
              <a
                href="/"
                class="px-4 py-2.5 bg-blue-700 hover:bg-blue-800 text-white text-xs font-bold rounded-lg transition-colors shrink-0"
              >
                ✍️ Ir al Firmador Principal →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial & Technical Guide -->
  <article class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">
          Arquitectura técnica: Cómo funciona la purga de firmas criptográficas en PDF
        </h2>
        <p class="text-slate-600 text-sm mt-3 leading-relaxed">
          En la especificación oficial <strong>ISO 32000-1</strong> del formato PDF, una firma digital no es una capa gráfica editable ordinaria, sino un conjunto complejo de estructuras de datos criptográficos vinculados al catálogo raíz (<code>/Root</code>). Al firmar un documento con AutoFirma, Adobe Acrobat o cualquier certificado de la FNMT, se generan dos elementos inmutables:
        </p>
        <ul class="list-disc list-inside text-xs sm:text-sm text-slate-600 mt-2 space-y-1">
          <li><strong>El diccionario de formulario (/AcroForm):</strong> Contiene el campo de firma de tipo <code>/FT /Sig</code> y establece la bandera <code>/SigFlags 3</code> para indicar que el archivo contiene firmas activas y prohibir alteraciones no autorizadas.</li>
          <li><strong>Las anotaciones visuales (/Annots):</strong> Corresponden al recuadro o sello visual donde se muestran los datos del firmante, fecha y motivo de la firma.</li>
        </ul>
        <p class="text-slate-600 text-sm mt-3 leading-relaxed">
          Nuestra utilidad web procesa el árbol de objetos del documento sin recurrir a impresiones virtuales. Recorre cada página, extrae con seguridad las referencias a los widgets de firma, neutraliza los indicadores de bloqueo en el catálogo <code>/AcroForm</code> y recompila un PDF totalmente limpio, preservando el 100% de la calidad tipográfica vectorial, enlaces hipertexto y formularios interactivos.
        </p>
      </div>

      <!-- Common Scenarios -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-4">
        <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl">
          <div class="text-2xl mb-2">🏷️</div>
          <h3 class="font-bold text-slate-900 text-sm">Sello Mal Posicionado</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Si el sello de firma se estampó sobre el número de cuenta bancaria o el texto del contrato, retira la firma y vuelve a estamparlo en la zona correcta.
          </p>
        </div>
        <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl">
          <div class="text-2xl mb-2">👤</div>
          <h3 class="font-bold text-slate-900 text-sm">Certificado Equivocado</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Si firmaste como persona física cuando debías firmar como representante de persona jurídica (CIF de empresa), desbloquea el PDF en segundos.
          </p>
        </div>
        <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl">
          <div class="text-2xl mb-2">✏️</div>
          <h3 class="font-bold text-slate-900 text-sm">Corrección de Cláusulas</h3>
          <p class="text-xs text-slate-600 mt-1 leading-relaxed">
            Modifica cualquier importe o fecha en el borrador antes de enviar la versión definitiva a la otra parte firmante.
          </p>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="pt-6 border-t border-slate-200 space-y-4">
        <h3 class="text-xl font-bold text-slate-900">Preguntas Frecuentes sobre el desbloqueo de PDFs firmados</h3>
        {faqs.map((f) => (
          <div class="p-5 bg-slate-50 border border-slate-200 rounded-xl">
            <h4 class="text-sm font-bold text-slate-900">{f.q}</h4>
            <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </article>

  <!-- Schema JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />
</Layout>

<script>
  import { PDFDocument, PDFName, PDFDict, PDFArray } from 'pdf-lib';

  const fileInput = document.getElementById('rm-pdf-input') as HTMLInputElement;
  const dropzone = document.getElementById('rm-pdf-dropzone') as HTMLElement;
  const titleEl = document.getElementById('rm-pdf-title') as HTMLElement;
  const subEl = document.getElementById('rm-pdf-sub') as HTMLElement;
  const statusBox = document.getElementById('rm-status-box') as HTMLElement;
  const resultBox = document.getElementById('rm-result-box') as HTMLElement;
  const resultDesc = document.getElementById('rm-result-desc') as HTMLElement;
  const downloadBtn = document.getElementById('rm-download-btn') as HTMLAnchorElement;

  let currentBlobUrl: string | null = null;

  function showStatus(msg: string, isError = false) {
    statusBox.classList.remove('hidden', 'bg-red-50', 'text-red-800', 'border-red-200', 'bg-blue-50', 'text-blue-800', 'border-blue-200');
    statusBox.classList.add('border');
    if (isError) {
      statusBox.classList.add('bg-red-50', 'text-red-800', 'border-red-200');
    } else {
      statusBox.classList.add('bg-blue-50', 'text-blue-800', 'border-blue-200');
    }
    statusBox.textContent = msg;
  }

  async function stripSignaturesFromPdf(file: File) {
    titleEl.textContent = `📄 ${file.name}`;
    subEl.textContent = `${(file.size / 1024).toFixed(1)} KB · Limpiando firmas criptográficas...`;
    resultBox.classList.add('hidden');
    showStatus('⏳ Inspeccionando estructura /AcroForm y eliminando diccionarios /Sig...', false);

    try {
      const buffer = await file.arrayBuffer();
      const pdfDoc = await PDFDocument.load(buffer, { ignoreEncryption: true });
      let removedCount = 0;

      // 1. Remove /FT /Sig annotations from every page
      for (const page of pdfDoc.getPages()) {
        const annots = page.node.lookupMaybe(PDFName.of('Annots'), PDFArray);
        if (!annots) continue;

        for (let i = annots.size() - 1; i >= 0; i--) {
          const annotDict = annots.lookupMaybe(i, PDFDict);
          if (!annotDict) continue;
          const ft = annotDict.lookup(PDFName.of('FT'));
          if (ft && ft.toString() === '/Sig') {
            annots.remove(i);
            removedCount++;
          }
        }
      }

      // 2. Clean /AcroForm /Fields and reset /SigFlags
      const acroForm = pdfDoc.catalog.lookupMaybe(PDFName.of('AcroForm'), PDFDict);
      if (acroForm) {
        acroForm.delete(PDFName.of('SigFlags'));
        const fields = acroForm.lookupMaybe(PDFName.of('Fields'), PDFArray);
        if (fields) {
          for (let i = fields.size() - 1; i >= 0; i--) {
            const fieldDict = fields.lookupMaybe(i, PDFDict);
            if (!fieldDict) continue;
            const ft = fieldDict.lookup(PDFName.of('FT'));
            if (ft && ft.toString() === '/Sig') {
              fields.remove(i);
            }
          }
        }
      }

      const cleanedBytes = await pdfDoc.save();
      if (currentBlobUrl) URL.revokeObjectURL(currentBlobUrl);
      const blob = new Blob([cleanedBytes], { type: 'application/pdf' });
      currentBlobUrl = URL.createObjectURL(blob);

      const baseName = file.name.replace(/\.pdf$/i, '');
      downloadBtn.href = currentBlobUrl;
      downloadBtn.download = `${baseName}_Sin_Firma.pdf`;

      statusBox.classList.add('hidden');
      resultDesc.textContent =
        removedCount > 0
          ? `Se han eliminado ${removedCount} firma(s) digital(es) y sus sellos visuales asociados. El documento está desbloqueado.`
          : `Se ha generado una copia limpia y desbloqueada del PDF sin restricciones de firma.`;
      resultBox.classList.remove('hidden');
    } catch (err: any) {
      showStatus(`❌ Error al procesar el archivo PDF: ${err?.message || 'Formato no soportado.'}`, true);
    }
  }

  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.[0]) stripSignaturesFromPdf(fileInput.files[0]);
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-amber-600');
  });
  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-amber-600');
  });
  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-amber-600');
    if (e.dataTransfer?.files?.[0]) stripSignaturesFromPdf(e.dataTransfer.files[0]);
  });
</script>
