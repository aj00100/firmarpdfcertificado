---
// src/components/SigningStudio.astro
interface Props {
  headline?: string;
  subheadline?: string;
}

const {
  headline = "Firma tus PDF con Certificado Digital en Segundos",
  subheadline = "100% en tu navegador. Ni tus documentos ni tu certificado salen de tu ordenador o móvil. Sin instalar AutoFirma."
} = Astro.props;
---

<div class="signing-studio max-w-4xl mx-auto my-8 p-6 sm:p-8 bg-white border border-slate-200 rounded-2xl shadow-sm">
  <div class="text-center mb-8">
    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 mb-3">
      <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
      100% Privado en Local · Sin Servidores · PAdES-B-B
    </span>
    <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">{headline}</h2>
    <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-2xl mx-auto">{subheadline}</p>
  </div>

  <!-- Unified 1-Screen Dropzone Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
    <!-- 1. PDF File Input -->
    <div class="drop-card border-2 border-dashed border-slate-300 hover:border-blue-500 rounded-xl p-6 text-center cursor-pointer transition-colors bg-slate-50 hover:bg-blue-50/40" id="pdf-dropzone">
      <input type="file" id="pdf-input" accept="application/pdf" class="hidden" />
      <div id="pdf-empty-state">
        <svg class="w-10 h-10 mx-auto text-slate-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
        <p class="text-sm font-semibold text-slate-800">1. Selecciona o arrastra tu PDF</p>
        <p class="text-xs text-slate-500 mt-1">Cualquier documento o formulario oficial</p>
      </div>
      <div id="pdf-loaded-state" class="hidden">
        <span class="inline-flex items-center text-xs font-medium text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full mb-2">PDF Cargado</span>
        <p class="text-sm font-bold text-slate-900 truncate" id="pdf-file-name">documento.pdf</p>
        <p class="text-xs text-slate-500 mt-0.5" id="pdf-file-size">0 KB</p>
        <button type="button" class="mt-3 text-xs text-blue-600 hover:underline" id="btn-change-pdf">Cambiar documento</button>
      </div>
    </div>

    <!-- 2. P12 Certificate Input -->
    <div class="drop-card border-2 border-dashed border-slate-300 hover:border-blue-500 rounded-xl p-6 text-center cursor-pointer transition-colors bg-slate-50 hover:bg-blue-50/40" id="cert-dropzone">
      <input type="file" id="cert-input" accept=".p12,.pfx" class="hidden" />
      <div id="cert-empty-state">
        <svg class="w-10 h-10 mx-auto text-slate-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
        <p class="text-sm font-semibold text-slate-800">2. Tu certificado digital (.p12 / .pfx)</p>
        <p class="text-xs text-slate-500 mt-1">FNMT, DNIe, ACCV, Camerfirma o CatCert</p>
      </div>
      <div id="cert-loaded-state" class="hidden">
        <span class="inline-flex items-center text-xs font-medium text-emerald-700 bg-emerald-100 px-2.5 py-0.5 rounded-full mb-2">Certificado Seleccionado</span>
        <p class="text-sm font-bold text-slate-900 truncate" id="cert-file-name">certificado.p12</p>
        <p class="text-xs text-slate-500 mt-0.5" id="cert-file-size">0 KB</p>
        <button type="button" class="mt-3 text-xs text-blue-600 hover:underline" id="btn-change-cert">Cambiar certificado</button>
      </div>
    </div>
  </div>

  <!-- Password & Position Settings -->
  <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 mb-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="cert-password" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Contraseña del Certificado
        </label>
        <div class="relative">
          <input
            type="password"
            id="cert-password"
            placeholder="Introduce la clave de tu .p12"
            class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          />
          <button type="button" id="btn-toggle-password" class="absolute right-3 top-2.5 text-xs text-slate-400 hover:text-slate-600">
            Mostrar
          </button>
        </div>
        <p class="text-[11px] text-slate-500 mt-1">La contraseña nunca se envía a ningún servidor; se usa en tu RAM.</p>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
          Posición del Sello Administrativo
        </label>
        <select id="stamp-position" class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-lg text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="bottom-right">Esquina inferior derecha (Recomendada)</option>
          <option value="bottom-left">Esquina inferior izquierda</option>
          <option value="top-right">Esquina superior derecha</option>
          <option value="top-left">Esquina superior izquierda</option>
        </select>
        <p class="text-[11px] text-slate-500 mt-1">Sello rectangular oficial conforme a Ley 6/2020 y eIDAS.</p>
      </div>
    </div>
  </div>

  <!-- Error Alert -->
  <div id="sign-error" class="hidden mb-6 p-4 bg-rose-50 border-l-4 border-rose-500 rounded-r-xl">
    <div class="flex items-start">
      <span class="text-rose-600 font-bold mr-2 text-lg">✕</span>
      <div>
        <p class="text-sm font-bold text-rose-900" id="sign-error-title">Error al firmar</p>
        <p class="text-xs text-rose-700 mt-0.5" id="sign-error-desc"></p>
      </div>
    </div>
  </div>

  <!-- Progress State -->
  <div id="sign-progress-box" class="hidden mb-6 p-5 bg-blue-50 border border-blue-200 rounded-xl text-center">
    <div class="inline-block animate-spin w-6 h-6 border-2 border-blue-600 border-t-transparent rounded-full mb-2"></div>
    <p class="text-sm font-semibold text-blue-900" id="sign-progress-text">Procesando firma criptográfica...</p>
    <p class="text-xs text-blue-600 mt-1">Todo el cálculo criptográfico ocurre en el procesador de tu dispositivo.</p>
  </div>

  <!-- Action Button -->
  <div class="text-center" id="action-wrapper">
    <button
      type="button"
      id="btn-sign-pdf"
      disabled
      class="w-full sm:w-auto px-8 py-3.5 bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-semibold text-base rounded-xl shadow-sm transition-all"
    >
      Firmar PDF con Certificado Digital
    </button>
  </div>

  <!-- Success State -->
  <div id="sign-success-box" class="hidden mt-6 p-6 bg-emerald-50 border border-emerald-200 rounded-2xl text-center">
    <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-3">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
    </div>
    <h3 class="text-xl font-bold text-emerald-950">¡Documento Firmado con Éxito!</h3>
    <p class="text-sm text-emerald-800 mt-1 max-w-lg mx-auto">
      Se ha generado una firma criptográfica avanzada PAdES-B-B (ETSI EN 319 142-1) verificable en Adobe Reader y sedes electrónicas.
    </p>

    <!-- Signer Details Box -->
    <div class="mt-4 p-4 bg-white/80 border border-emerald-200 rounded-xl text-left max-w-md mx-auto text-xs space-y-1.5 text-slate-700">
      <p><strong>Firmante:</strong> <span id="res-signer">—</span></p>
      <p><strong>NIF/Documento:</strong> <span id="res-nif">—</span></p>
      <p><strong>Autoridad Emisora:</strong> <span id="res-issuer">—</span></p>
      <p><strong>Normativa:</strong> <span class="text-emerald-700 font-medium">eIDAS (UE 910/2014) & Ley 6/2020</span></p>
    </div>

    <!-- Download Button -->
    <div class="mt-6 flex flex-wrap justify-center gap-4">
      <a
        id="btn-download-signed"
        download="Documento_Firmado.pdf"
        href="#"
        class="inline-flex items-center px-8 py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow-sm transition-all"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
        Descargar PDF Firmado
      </a>
      <button
        type="button"
        id="btn-sign-another"
        class="px-5 py-3.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold text-sm rounded-xl transition-all"
      >
        Firmar otro documento
      </button>
    </div>

    <!-- VeriFactu 2026 Warning Callout (The €50,000 High-Ticket Hook) -->
    <div class="mt-8 text-left bg-amber-50/90 border-l-4 border-amber-500 p-4 sm:p-5 rounded-r-xl shadow-sm">
      <div class="flex items-start">
        <span class="text-amber-600 text-xl font-bold mr-3">⚠️</span>
        <div>
          <h4 class="font-bold text-amber-950 text-sm">Aviso AEAT para Autónomos y Pymes (Normativa VeriFactu 2026)</h4>
          <p class="text-amber-900/90 text-xs mt-1 leading-relaxed">
            Si estás firmando facturas o presupuestos manualmente en PDF o Excel, la Agencia Tributaria sanciona con hasta <strong>50.000 €</strong> el uso de software de facturación no certificado. Pásate gratis a un sistema homologado con firma electrónica integrada.
          </p>
          <div class="mt-3 flex flex-wrap gap-2.5">
            <a
              href="https://firmarpdfcertificado.com/r/holded"
              target="_blank"
              rel="nofollow noopener"
              class="inline-flex items-center px-3.5 py-1.5 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-lg shadow-sm"
            >
              Probar software homologado VeriFactu (Holded) →
            </a>
            <a
              href="https://firmarpdfcertificado.com/r/qonto"
              target="_blank"
              rel="nofollow noopener"
              class="inline-flex items-center px-3.5 py-1.5 bg-white hover:bg-amber-100 text-amber-950 text-xs font-semibold border border-amber-300 rounded-lg"
            >
              Cuenta negocios con facturación (Qonto) →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let pdfArrayBuffer: ArrayBuffer | null = null;
  let certArrayBuffer: ArrayBuffer | null = null;
  let activeWorker: Worker | null = null;

  const pdfInput = document.getElementById('pdf-input') as HTMLInputElement;
  const certInput = document.getElementById('cert-input') as HTMLInputElement;
  const certPassword = document.getElementById('cert-password') as HTMLInputElement;
  const btnTogglePassword = document.getElementById('btn-toggle-password') as HTMLButtonElement;
  const stampPosition = document.getElementById('stamp-position') as HTMLSelectElement;
  const btnSignPdf = document.getElementById('btn-sign-pdf') as HTMLButtonElement;

  const pdfDropzone = document.getElementById('pdf-dropzone')!;
  const certDropzone = document.getElementById('cert-dropzone')!;
  const pdfEmptyState = document.getElementById('pdf-empty-state')!;
  const pdfLoadedState = document.getElementById('pdf-loaded-state')!;
  const certEmptyState = document.getElementById('cert-empty-state')!;
  const certLoadedState = document.getElementById('cert-loaded-state')!;

  const signError = document.getElementById('sign-error')!;
  const signErrorDesc = document.getElementById('sign-error-desc')!;
  const signProgressBox = document.getElementById('sign-progress-box')!;
  const signProgressText = document.getElementById('sign-progress-text')!;
  const signSuccessBox = document.getElementById('sign-success-box')!;
  const actionWrapper = document.getElementById('action-wrapper')!;

  const btnDownloadSigned = document.getElementById('btn-download-signed') as HTMLAnchorElement;
  const btnSignAnother = document.getElementById('btn-sign-another') as HTMLButtonElement;

  // Toggle Password
  btnTogglePassword.addEventListener('click', () => {
    if (certPassword.type === 'password') {
      certPassword.type = 'text';
      btnTogglePassword.textContent = 'Ocultar';
    } else {
      certPassword.type = 'password';
      btnTogglePassword.textContent = 'Mostrar';
    }
  });

  // Dropzone triggers
  pdfDropzone.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id !== 'btn-change-pdf') pdfInput.click();
  });
  certDropzone.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id !== 'btn-change-cert') certInput.click();
  });

  document.getElementById('btn-change-pdf')?.addEventListener('click', (e) => {
    e.stopPropagation();
    pdfInput.click();
  });
  document.getElementById('btn-change-cert')?.addEventListener('click', (e) => {
    e.stopPropagation();
    certInput.click();
  });

  // Handle PDF file selection
  pdfInput.addEventListener('change', async () => {
    const file = pdfInput.files?.[0];
    if (file) {
      pdfArrayBuffer = await file.arrayBuffer();
      document.getElementById('pdf-file-name')!.textContent = file.name;
      document.getElementById('pdf-file-size')!.textContent = `${(file.size / 1024).toFixed(1)} KB`;
      pdfEmptyState.classList.add('hidden');
      pdfLoadedState.classList.remove('hidden');
      checkReadyToSign();
    }
  });

  // Handle Cert file selection
  certInput.addEventListener('change', async () => {
    const file = certInput.files?.[0];
    if (file) {
      certArrayBuffer = await file.arrayBuffer();
      document.getElementById('cert-file-name')!.textContent = file.name;
      document.getElementById('cert-file-size')!.textContent = `${(file.size / 1024).toFixed(1)} KB`;
      certEmptyState.classList.add('hidden');
      certLoadedState.classList.remove('hidden');
      checkReadyToSign();
    }
  });

  certPassword.addEventListener('input', checkReadyToSign);

  function checkReadyToSign() {
    const isReady = Boolean(pdfArrayBuffer && certArrayBuffer && certPassword.value.trim().length > 0);
    btnSignPdf.disabled = !isReady;
  }

  // Handle Sign execution
  btnSignPdf.addEventListener('click', () => {
    if (!pdfArrayBuffer || !certArrayBuffer || !certPassword.value) return;

    signError.classList.add('hidden');
    signSuccessBox.classList.add('hidden');
    signProgressBox.classList.remove('hidden');
    actionWrapper.classList.add('hidden');

    // Terminate existing worker if any
    if (activeWorker) {
      activeWorker.terminate();
    }

    activeWorker = new Worker(new URL('../workers/signer.worker.ts', import.meta.url), {
      type: 'module',
    });

    activeWorker.onmessage = (e) => {
      const data = e.data;

      if (data.status === 'progress' || data.status === 'parsing' || data.status === 'preparing' || data.status === 'signing') {
        signProgressText.textContent = data.message;
      } else if (data.status === 'done') {
        signProgressBox.classList.add('hidden');
        signSuccessBox.classList.remove('hidden');

        // Create download blob
        const blob = new Blob([data.signedPdf], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        btnDownloadSigned.href = url;
        btnDownloadSigned.download = `${(pdfInput.files?.[0]?.name || 'documento').replace(/\.pdf$/i, '')}_firmado.pdf`;

        // Render metadata
        document.getElementById('res-signer')!.textContent = data.metadata?.signer || data.signerName || 'Titular Verificado';
        document.getElementById('res-nif')!.textContent = data.metadata?.nif || data.nif || 'Verificado';
        document.getElementById('res-issuer')!.textContent = data.metadata?.issuer || data.issuer || 'FNMT-RCM';
      } else if (data.status === 'error') {
        signProgressBox.classList.add('hidden');
        actionWrapper.classList.remove('hidden');
        signError.classList.remove('hidden');
        signErrorDesc.textContent = data.error || 'No se pudo firmar el documento.';
      }
    };

    activeWorker.onerror = (err) => {
      signProgressBox.classList.add('hidden');
      actionWrapper.classList.remove('hidden');
      signError.classList.remove('hidden');
      signErrorDesc.textContent = `Error de ejecución: ${err.message}`;
    };

    // Calculate position coordinates
    let stampX = 350;
    let stampY = 25;
    const pos = stampPosition.value;
    if (pos === 'bottom-left') {
      stampX = 25;
      stampY = 25;
    } else if (pos === 'top-right') {
      stampX = 350;
      stampY = 740;
    } else if (pos === 'top-left') {
      stampX = 25;
      stampY = 740;
    }

    // Dispatch to Web Worker (Clone buffers to keep original memory safe)
    activeWorker.postMessage({
      pdfBuffer: pdfArrayBuffer.slice(0),
      p12Buffer: certArrayBuffer.slice(0),
      password: certPassword.value,
      stampConfig: {
        x: stampX,
        y: stampY,
        width: 230,
        height: 70,
      },
    });
  });

  // Sign another document
  btnSignAnother.addEventListener('click', () => {
    signSuccessBox.classList.add('hidden');
    actionWrapper.classList.remove('hidden');
    pdfInput.value = '';
    certInput.value = '';
    certPassword.value = '';
    pdfArrayBuffer = null;
    certArrayBuffer = null;
    pdfLoadedState.classList.add('hidden');
    pdfEmptyState.classList.remove('hidden');
    certLoadedState.classList.add('hidden');
    certEmptyState.classList.remove('hidden');
    checkReadyToSign();
  });
</script>
