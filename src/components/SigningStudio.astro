---
// src/components/SigningStudio.astro
interface Props {
  title?: string;
  subtitle?: string;
  defaultPosition?: 'bottom-right' | 'bottom-left' | 'bottom-center' | 'first-bottom-right' | 'top-right';
}

const {
  title = 'Firmar PDF con Certificado Digital (FNMT / DNIe)',
  subtitle = '100% privado en tu navegador. Tus archivos y tu certificado jamás salen de tu dispositivo.',
  defaultPosition = 'bottom-right',
} = Astro.props;
---

<section class="w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-lg overflow-hidden my-6">
  <!-- Top Trust Header -->
  <div class="bg-slate-900 text-white px-6 py-4 flex flex-wrap items-center justify-between gap-2">
    <div>
      <h2 class="text-lg font-bold tracking-tight flex items-center gap-2">
        <span>🔒</span> {title}
      </h2>
      <p class="text-xs text-slate-300 mt-0.5">{subtitle}</p>
    </div>
    <div class="flex items-center gap-2 text-xs bg-emerald-950/80 border border-emerald-700 text-emerald-300 px-3 py-1.5 rounded-full font-medium">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      Estándar ETSI PAdES-B-B · eIDAS
    </div>
  </div>

  <div class="p-6 md:p-8 space-y-6">
    <!-- Unified 1-Screen Dual Dropzone Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      <!-- 1. PDF Dropzone -->
      <label
        id="pdf-dropzone"
        for="pdf-input"
        class="group relative flex flex-col items-center justify-center p-6 border-2 border-dashed border-slate-300 hover:border-blue-600 rounded-xl bg-slate-50/70 hover:bg-blue-50/40 cursor-pointer transition-all text-center min-h-[170px]"
      >
        <input id="pdf-input" type="file" accept="application/pdf,.pdf" class="sr-only" />
        <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-2xl mb-3 group-hover:scale-105 transition-transform">
          📄
        </div>
        <span class="text-sm font-bold text-slate-800" id="pdf-label-title">
          1. Selecciona o arrastra tu archivo PDF
        </span>
        <span class="text-xs text-slate-500 mt-1" id="pdf-label-sub">
          Contratos, facturas, modelos AEAT o escritos (Máx. 100 MB)
        </span>
      </label>

      <!-- 2. Certificate (.p12 / .pfx) Dropzone -->
      <label
        id="p12-dropzone"
        for="p12-input"
        class="group relative flex flex-col items-center justify-center p-6 border-2 border-dashed border-slate-300 hover:border-blue-600 rounded-xl bg-slate-50/70 hover:bg-blue-50/40 cursor-pointer transition-all text-center min-h-[170px]"
      >
        <input id="p12-input" type="file" accept=".p12,.pfx,application/x-pkcs12" class="sr-only" />
        <div class="w-12 h-12 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-2xl mb-3 group-hover:scale-105 transition-transform">
          🪪
        </div>
        <span class="text-sm font-bold text-slate-800" id="p12-label-title">
          2. Carga tu Certificado Digital (.p12 o .pfx)
        </span>
        <span class="text-xs text-slate-500 mt-1" id="p12-label-sub">
          FNMT, ACCV, Camerfirma o copia exportada de tu navegador
        </span>
      </label>
    </div>

    <!-- Password & Stamp Position Bar -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end bg-slate-50 p-4 rounded-xl border border-slate-200">
      <div class="md:col-span-5">
        <label for="cert-password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          3. Contraseña del Certificado (.p12 / .pfx)
        </label>
        <div class="relative">
          <input
            id="cert-password"
            type="password"
            placeholder="Introduce la clave de exportación..."
            class="w-full px-3.5 py-2.5 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none pr-10"
          />
          <button
            type="button"
            id="toggle-password"
            class="absolute inset-y-0 right-0 px-3 text-slate-400 hover:text-slate-600 text-xs font-medium"
            aria-label="Mostrar u ocultar contraseña"
          >
            Ver
          </button>
        </div>
      </div>

      <div class="md:col-span-4">
        <label for="stamp-position" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
          Posición del Sello Oficial
        </label>
        <select
          id="stamp-position"
          class="w-full px-3 py-2.5 text-sm bg-white border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-600 outline-none"
        >
          <option value="bottom-right" selected={defaultPosition === 'bottom-right'}>Última página · Abajo Derecha (Firma principal)</option>
          <option value="bottom-left" selected={defaultPosition === 'bottom-left'}>Última página · Abajo Izquierda (2ª Firma / Cofirma)</option>
          <option value="bottom-center" selected={defaultPosition === 'bottom-center'}>Última página · Abajo Centro (3ª Firma)</option>
          <option value="top-right" selected={defaultPosition === 'top-right'}>Última página · Arriba Derecha</option>
          <option value="first-bottom-right" selected={defaultPosition === 'first-bottom-right'}>Primera página · Abajo Derecha</option>
        </select>
      </div>

      <div class="md:col-span-3">
        <button
          id="sign-btn"
          type="button"
          class="w-full py-2.5 px-4 bg-blue-700 hover:bg-blue-800 active:bg-blue-900 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-bold text-sm rounded-lg shadow-sm transition-colors flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>✍️ Firmar PDF Ahora</span>
        </button>
      </div>
    </div>

    <!-- Live Official Administrative Stamp Preview -->
    <div class="border border-slate-200 rounded-xl p-4 bg-white">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
          Vista Previa del Sello Administrativo Oficial (Requerido por AEAT / Red.es)
        </span>
        <span class="text-[11px] text-blue-700 font-medium">Formato Rectangular Homologado</span>
      </div>
      <div class="max-w-md bg-[#f7faff] border-[1.5px] border-[#1e3a8a] border-l-[5px] p-3 rounded font-sans text-left shadow-2xs">
        <p class="text-[10px] font-bold text-[#1e3a8a] tracking-wide uppercase">
          DOCUMENTO FIRMADO DIGITALMENTE
        </p>
        <p class="text-[11px] font-bold text-slate-900 mt-0.5" id="preview-signer">
          Firmante: [TU NOMBRE Y APELLIDOS DEL CERTIFICADO]
        </p>
        <p class="text-[10px] text-slate-700">
          NIF/NIE: <span id="preview-nif">[EXTRAÍDO AUTOMÁTICAMENTE]</span> | Emisor: FNMT-RCM
        </p>
        <p class="text-[10px] text-slate-700">
          Fecha: <span id="preview-date">{new Date().toLocaleDateString('es-ES')}</span> CET · Huella SHA-256 incluida
        </p>
        <p class="text-[9px] text-slate-500 mt-1">
          Validez jurídica conforme a Reglamento (UE) 910/2014 (eIDAS) y Ley 6/2020
        </p>
      </div>
    </div>

    <!-- Status / Error Alert Box -->
    <div id="status-box" class="hidden rounded-xl p-4 text-sm font-medium"></div>

    <!-- Signed Result & VeriFactu 2026 High-Ticket B2B Affiliate Hook -->
    <div id="result-container" class="hidden space-y-5 pt-2">
      <div class="bg-emerald-50 border border-emerald-300 rounded-xl p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <div class="inline-flex items-center gap-1.5 text-emerald-800 font-bold text-base">
            <span>✅</span> ¡Documento PDF Firmado con Éxito (PAdES-B-B)!
          </div>
          <p class="text-xs text-emerald-700" id="signed-meta-summary">
            Firma criptográfica incrustada con sello administrativo oficial.
          </p>
        </div>
        <a
          id="download-btn"
          href="#"
          download="Documento_Firmado.pdf"
          class="w-full sm:w-auto text-center px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow-md transition-colors shrink-0"
        >
          ⬇️ Descargar PDF Firmado
        </a>
      </div>

      <!-- €50,000 VeriFactu 2026 B2B Affiliate Callout -->
      <div class="verifactu-callout bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-xl shadow-xs">
        <div class="flex items-start">
          <span class="text-amber-600 text-2xl mr-3 select-none">⚠️</span>
          <div>
            <h3 class="font-bold text-amber-950 text-sm md:text-base">
              Aviso Importante para Autónomos y Pymes (Normativa VeriFactu 2026)
            </h3>
            <p class="text-amber-900 text-xs md:text-sm mt-1 leading-relaxed">
              Si estás firmando facturas o presupuestos manualmente en PDF o Excel, recuerda que la Agencia Tributaria (AEAT) sanciona con hasta <strong>50.000 €</strong> el uso de software de facturación no certificado.
            </p>
            <div class="mt-3 flex flex-wrap gap-3">
              <a
                href="/r/holded/"
                target="_blank"
                rel="nofollow noopener"
                class="inline-flex items-center px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-lg transition-colors"
              >
                Probar software homologado VeriFactu gratis (Holded) →
              </a>
              <a
                href="/r/qonto/"
                target="_blank"
                rel="nofollow noopener"
                class="inline-flex items-center px-4 py-2 bg-white hover:bg-amber-100 text-amber-900 text-xs font-semibold border border-amber-300 rounded-lg transition-colors"
              >
                Cuenta empresas con facturación integrada (Qonto) →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import SignerWorker from '../workers/signer.worker.ts?worker';

  const pdfInput = document.getElementById('pdf-input') as HTMLInputElement;
  const p12Input = document.getElementById('p12-input') as HTMLInputElement;
  const pdfDropzone = document.getElementById('pdf-dropzone') as HTMLElement;
  const p12Dropzone = document.getElementById('p12-dropzone') as HTMLElement;
  const pdfTitle = document.getElementById('pdf-label-title') as HTMLElement;
  const pdfSub = document.getElementById('pdf-label-sub') as HTMLElement;
  const p12Title = document.getElementById('p12-label-title') as HTMLElement;
  const p12Sub = document.getElementById('p12-label-sub') as HTMLElement;
  const passwordInput = document.getElementById('cert-password') as HTMLInputElement;
  const togglePassBtn = document.getElementById('toggle-password') as HTMLButtonElement;
  const positionSelect = document.getElementById('stamp-position') as HTMLSelectElement;
  const signBtn = document.getElementById('sign-btn') as HTMLButtonElement;
  const statusBox = document.getElementById('status-box') as HTMLElement;
  const resultContainer = document.getElementById('result-container') as HTMLElement;
  const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement;
  const signedMetaSummary = document.getElementById('signed-meta-summary') as HTMLElement;
  const previewSigner = document.getElementById('preview-signer') as HTMLElement;
  const previewNif = document.getElementById('preview-nif') as HTMLElement;

  let selectedPdfFile: File | null = null;
  let selectedP12File: File | null = null;
  let currentBlobUrl: string | null = null;

  function showStatus(message: string, type: 'info' | 'error' = 'info') {
    statusBox.classList.remove('hidden', 'bg-blue-50', 'text-blue-800', 'border-blue-200', 'bg-red-50', 'text-red-800', 'border-red-200');
    statusBox.classList.add('border');
    if (type === 'error') {
      statusBox.classList.add('bg-red-50', 'text-red-800', 'border-red-200');
    } else {
      statusBox.classList.add('bg-blue-50', 'text-blue-800', 'border-blue-200');
    }
    statusBox.textContent = message;
  }

  function handlePdfFile(file: File) {
    selectedPdfFile = file;
    pdfTitle.textContent = `✅ ${file.name}`;
    pdfSub.textContent = `${(file.size / 1024).toFixed(1)} KB · Listo para firmar`;
    pdfDropzone.classList.add('border-emerald-500', 'bg-emerald-50/30');
  }

  function handleP12File(file: File) {
    selectedP12File = file;
    p12Title.textContent = `✅ ${file.name}`;
    p12Sub.textContent = `Certificado PKCS#12 cargado en memoria local`;
    p12Dropzone.classList.add('border-emerald-500', 'bg-emerald-50/30');
  }

  pdfInput?.addEventListener('change', () => {
    if (pdfInput.files?.[0]) handlePdfFile(pdfInput.files[0]);
  });

  p12Input?.addEventListener('change', () => {
    if (p12Input.files?.[0]) handleP12File(p12Input.files[0]);
  });

  // Drag & Drop support for both zones
  [
    { zone: pdfDropzone, handler: handlePdfFile },
    { zone: p12Dropzone, handler: handleP12File },
  ].forEach(({ zone, handler }) => {
    zone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      zone.classList.add('border-blue-600', 'bg-blue-50/50');
    });
    zone?.addEventListener('dragleave', () => {
      zone.classList.remove('border-blue-600', 'bg-blue-50/50');
    });
    zone?.addEventListener('drop', (e) => {
      e.preventDefault();
      zone.classList.remove('border-blue-600', 'bg-blue-50/50');
      const file = e.dataTransfer?.files?.[0];
      if (file) handler(file);
    });
  });

  togglePassBtn?.addEventListener('click', () => {
    const isPass = passwordInput.type === 'password';
    passwordInput.type = isPass ? 'text' : 'password';
    togglePassBtn.textContent = isPass ? 'Ocultar' : 'Ver';
  });

  signBtn?.addEventListener('click', async () => {
    if (!selectedPdfFile) {
      showStatus('⚠️ Por favor, selecciona primero el documento PDF que deseas firmar.', 'error');
      return;
    }
    if (!selectedP12File) {
      showStatus('⚠️ Por favor, selecciona tu archivo de certificado digital (.p12 o .pfx).', 'error');
      return;
    }

    resultContainer.classList.add('hidden');
    signBtn.disabled = true;
    showStatus('⏳ Inicializando motor criptográfico PAdES-B-B en tu navegador...', 'info');

    try {
      // Read fresh ArrayBuffers from File blobs so retries never hit detached buffer errors
      const [pdfBuffer, p12Buffer] = await Promise.all([
        selectedPdfFile.arrayBuffer(),
        selectedP12File.arrayBuffer(),
      ]);

      const pos = positionSelect.value;
      let stampX: number | undefined = undefined;
      let stampY: number = 30;
      let pageIndex: number | undefined = undefined;

      if (pos === 'first-bottom-right') {
        pageIndex = 0;
      } else if (pos === 'bottom-left') {
        stampX = 35;
      } else if (pos === 'bottom-center') {
        stampX = 180;
      } else if (pos === 'top-right') {
        stampY = 720;
      }

      const stampConfig = {
        pageIndex,
        x: stampX,
        y: stampY,
        width: 220,
        height: 75,
      };

      const worker = new SignerWorker();

      worker.onmessage = (e) => {
        const { status, message, signedPdf, metadata, error } = e.data;

        if (status === 'parsing' || status === 'preparing' || status === 'signing') {
          showStatus(`🔐 ${message}`, 'info');
        } else if (status === 'done') {
          statusBox.classList.add('hidden');
          signBtn.disabled = false;

          if (currentBlobUrl) URL.revokeObjectURL(currentBlobUrl);
          const blob = new Blob([signedPdf], { type: 'application/pdf' });
          currentBlobUrl = URL.createObjectURL(blob);

          const baseName = selectedPdfFile!.name.replace(/\.pdf$/i, '');
          downloadBtn.href = currentBlobUrl;
          downloadBtn.download = `${baseName}_Firmado.pdf`;

          if (metadata) {
            previewSigner.textContent = `Firmante: ${metadata.signer}`;
            previewNif.textContent = metadata.nif;
            signedMetaSummary.textContent = `Firmado por ${metadata.signer} (NIF: ${metadata.nif}) · Emisor: ${metadata.issuer}`;
          }

          resultContainer.classList.remove('hidden');
          worker.terminate();
        } else if (status === 'error') {
          signBtn.disabled = false;
          showStatus(`❌ ${error}`, 'error');
          worker.terminate();
        }
      };

      worker.onerror = (err) => {
        signBtn.disabled = false;
        showStatus(`❌ Error crítico en el Web Worker: ${err.message}`, 'error');
        worker.terminate();
      };

      worker.postMessage(
        {
          pdfBuffer,
          p12Buffer,
          password: passwordInput.value || '',
          stampConfig,
        },
        [pdfBuffer, p12Buffer]
      );
    } catch (err: any) {
      signBtn.disabled = false;
      showStatus(`❌ Error al leer los archivos locales: ${err?.message}`, 'error');
    }
  });
</script>
