---
// src/components/ValidatorStudio.astro
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Validar Firma Digital PDF Online (Verificador eIDAS / PAdES)',
  subtitle = 'Comprueba la autenticidad criptográfica, el certificado FNMT/DNIe del firmante y la integridad del documento 100% en tu navegador.',
} = Astro.props;
---

<section class="w-full max-w-4xl mx-auto bg-white border border-slate-200 rounded-2xl shadow-lg overflow-hidden my-6">
  <!-- Top Trust Header -->
  <div class="bg-slate-900 text-white px-6 py-4 flex flex-wrap items-center justify-between gap-2">
    <div>
      <h2 class="text-lg font-bold tracking-tight flex items-center gap-2">
        <span>🔍</span> {title}
      </h2>
      <p class="text-xs text-slate-300 mt-0.5">{subtitle}</p>
    </div>
    <div class="flex items-center gap-2 text-xs bg-blue-950/90 border border-blue-700 text-blue-300 px-3 py-1.5 rounded-full font-medium">
      <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
      Auditoría Criptográfica Local · Sin Subida
    </div>
  </div>

  <div class="p-6 md:p-8 space-y-6">
    <!-- PDF Upload Dropzone -->
    <label
      id="val-pdf-dropzone"
      for="val-pdf-input"
      class="group relative flex flex-col items-center justify-center p-8 border-2 border-dashed border-slate-300 hover:border-blue-600 rounded-xl bg-slate-50/70 hover:bg-blue-50/40 cursor-pointer transition-all text-center min-h-[190px]"
    >
      <input id="val-pdf-input" type="file" accept="application/pdf,.pdf" class="sr-only" />
      <div class="w-14 h-14 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center text-3xl mb-3 group-hover:scale-105 transition-transform">
        🛡️
      </div>
      <span class="text-base font-bold text-slate-800" id="val-pdf-title">
        Selecciona o arrastra aquí el archivo PDF firmado para verificarlo
      </span>
      <span class="text-xs text-slate-500 mt-1 max-w-lg" id="val-pdf-sub">
        Analiza firmas PAdES, CAdES y PKCS#7 generadas con AutoFirma, FNMT, DNIe o cualquier autoridad europea eIDAS.
      </span>
      <span class="mt-4 inline-flex items-center px-4 py-2 bg-blue-700 group-hover:bg-blue-800 text-white text-xs font-bold rounded-lg shadow-xs transition-colors">
        Analizar Firma Criptográfica →
      </span>
    </label>

    <!-- Status / Error Message -->
    <div id="val-status-box" class="hidden rounded-xl p-4 text-sm font-medium"></div>

    <!-- Validation Report Output Container -->
    <div id="val-report-container" class="hidden space-y-6">
      <!-- Overall Summary Banner -->
      <div id="val-summary-banner" class="rounded-xl p-5 border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2 font-bold text-base" id="val-summary-title"></div>
          <p class="text-xs leading-relaxed" id="val-summary-desc"></p>
        </div>
        <div id="val-summary-badge" class="px-3.5 py-1.5 rounded-full text-xs font-bold shrink-0"></div>
      </div>

      <!-- Signatures List -->
      <div id="val-signatures-list" class="space-y-4"></div>

      <!-- CTA to Sign a Document if Unsigned or Needs Counter-Signature -->
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="text-sm font-bold text-slate-800">¿Necesitas firmar o cofirmar este documento PDF?</p>
          <p class="text-xs text-slate-600">Añade tu firma digital PAdES-B-B con sello administrativo oficial en 1 clic sin instalar AutoFirma.</p>
        </div>
        <a
          href="/"
          class="px-4 py-2.5 bg-blue-700 hover:bg-blue-800 text-white text-xs font-bold rounded-lg transition-colors shrink-0"
        >
          ✍️ Ir al Firmador de PDF →
        </a>
      </div>

      <!-- €50,000 VeriFactu 2026 High-Ticket B2B Affiliate Hook -->
      <div class="verifactu-callout bg-amber-50 border-l-4 border-amber-500 p-5 rounded-r-xl shadow-xs">
        <div class="flex items-start">
          <span class="text-amber-600 text-2xl mr-3 select-none">⚠️</span>
          <div>
            <h3 class="font-bold text-amber-950 text-sm md:text-base">
              Aviso Importante para Autónomos y Pymes (Normativa VeriFactu 2026)
            </h3>
            <p class="text-amber-900 text-xs md:text-sm mt-1 leading-relaxed">
              Si estás validando o emitiendo facturas en PDF manualmente, recuerda que la Agencia Tributaria (AEAT) sanciona con hasta <strong>50.000 €</strong> el uso de software de facturación no certificado.
            </p>
            <div class="mt-3 flex flex-wrap gap-3">
              <a
                href="/r/holded/"
                target="_blank"
                rel="nofollow noopener"
                class="inline-flex items-center px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-semibold rounded-lg transition-colors"
              >
                Probar software homologado VeriFactu gratis (Holded) →
              </a>
              <a
                href="/r/qonto/"
                target="_blank"
                rel="nofollow noopener"
                class="inline-flex items-center px-4 py-2 bg-white hover:bg-amber-100 text-amber-900 text-xs font-semibold border border-amber-300 rounded-lg transition-colors"
              >
                Cuenta empresas con facturación integrada (Qonto) →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import forge from 'node-forge';

  interface ParsedSignatureInfo {
    index: number;
    subFilter: string;
    signerName: string;
    signerNif: string;
    issuerName: string;
    serialNumberHex: string;
    signingTime: Date | null;
    notBefore: Date;
    notAfter: Date;
    isIntegrityValid: boolean;
    isWithinValidityPeriod: boolean;
    hasPAdESCertV2Attr: boolean;
    digestAlgorithm: string;
    byteRange: [number, number, number, number];
    coversWholeDocument: boolean;
    documentSha256Preview: string;
  }

  const fileInput = document.getElementById('val-pdf-input') as HTMLInputElement;
  const dropzone = document.getElementById('val-pdf-dropzone') as HTMLElement;
  const titleEl = document.getElementById('val-pdf-title') as HTMLElement;
  const subEl = document.getElementById('val-pdf-sub') as HTMLElement;
  const statusBox = document.getElementById('val-status-box') as HTMLElement;
  const reportContainer = document.getElementById('val-report-container') as HTMLElement;
  const summaryBanner = document.getElementById('val-summary-banner') as HTMLElement;
  const summaryTitle = document.getElementById('val-summary-title') as HTMLElement;
  const summaryDesc = document.getElementById('val-summary-desc') as HTMLElement;
  const summaryBadge = document.getElementById('val-summary-badge') as HTMLElement;
  const signaturesList = document.getElementById('val-signatures-list') as HTMLElement;

  function showStatus(msg: string, type: 'info' | 'error' = 'info') {
    statusBox.classList.remove(
      'hidden',
      'bg-blue-50',
      'text-blue-800',
      'border-blue-200',
      'bg-red-50',
      'text-red-800',
      'border-red-200'
    );
    statusBox.classList.add('border');
    if (type === 'error') {
      statusBox.classList.add('bg-red-50', 'text-red-800', 'border-red-200');
    } else {
      statusBox.classList.add('bg-blue-50', 'text-blue-800', 'border-blue-200');
    }
    statusBox.textContent = msg;
  }

  function decodeCertField(field: any): string {
    if (!field || !field.value) return '';
    try {
      return forge.util.decodeUtf8(field.value);
    } catch {
      return String(field.value);
    }
  }

  async function inspectPdfSignatures(buffer: ArrayBuffer): Promise<ParsedSignatureInfo[]> {
    const pdfBytes = new Uint8Array(buffer);
    const decoder = new TextDecoder('latin1');
    const pdfStr = decoder.decode(pdfBytes);

    const fullHashBuf = await crypto.subtle.digest('SHA-256', buffer);
    const docHashPreview = Array.from(new Uint8Array(fullHashBuf))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('')
      .slice(0, 24)
      .toUpperCase();

    const byteRangeRegex = /\/ByteRange\s*\[\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s*\]/g;
    const results: ParsedSignatureInfo[] = [];
    let match: RegExpExecArray | null;
    let sigIndex = 0;

    while ((match = byteRangeRegex.exec(pdfStr)) !== null) {
      sigIndex++;
      const o1 = parseInt(match[1], 10);
      const l1 = parseInt(match[2], 10);
      const o2 = parseInt(match[3], 10);
      const l2 = parseInt(match[4], 10);

      const contextStart = Math.max(0, match.index - 400);
      const contextEnd = Math.min(pdfStr.length, match.index + 600);
      const dictContext = pdfStr.slice(contextStart, contextEnd);
      const subFilterMatch = dictContext.match(/\/SubFilter\s*\/([A-Za-z0-9._-]+)/);
      const subFilter = subFilterMatch ? subFilterMatch[1] : 'adbe.pkcs7.detached';

      let rawContentsSlice = pdfStr.slice(o1 + l1, o2).trim();
      if (rawContentsSlice.startsWith('<') && rawContentsSlice.endsWith('>')) {
        rawContentsSlice = rawContentsSlice.slice(1, -1);
      } else {
        const contentsMatch = pdfStr.slice(match.index).match(/\/Contents\s*<([0-9A-Fa-f\s]+)>/);
        if (!contentsMatch) continue;
        rawContentsSlice = contentsMatch[1];
      }

      const cleanHex = rawContentsSlice.replace(/\s+/g, '');
      const derBinaryStr = forge.util.hexToBytes(cleanHex);
      const derBuffer = forge.util.createBuffer(derBinaryStr);
      const cmsAsn1 = forge.asn1.fromDer(derBuffer, false);

      const p7 = (forge.pkcs7 as any).messageFromAsn1(cmsAsn1);
      const certs: forge.pki.Certificate[] = p7.certificates || [];

      let signerCert = certs[0];
      for (const cert of certs) {
        const bc = cert.getExtension('basicConstraints') as any;
        if (!bc || !bc.cA) {
          signerCert = cert;
          break;
        }
      }

      const cnField = signerCert?.subject.getField('CN');
      const signerName = decodeCertField(cnField) || 'Certificado X.509 Reconocido';

      const serialField =
        signerCert?.subject.getField({ type: '2.5.4.5' }) ||
        signerCert?.subject.getField('serialNumber');
      let signerNif = decodeCertField(serialField);
      const nifMatch = (signerNif || signerName).match(/\b([0-9]{8}[A-Z]|[XYZ][0-9]{7}[A-Z])\b/i);
      if (nifMatch) {
        signerNif = nifMatch[1].toUpperCase();
      } else if (signerNif.startsWith('IDCES-')) {
        signerNif = signerNif.replace('IDCES-', '');
      }

      const issuerField =
        signerCert?.issuer.getField('CN') || signerCert?.issuer.getField('O');
      const issuerName = decodeCertField(issuerField) || 'Autoridad de Certificación (CA)';

      let extractedDigestBytes: string | null = null;
      let signingTime: Date | null = null;
      let hasPAdESCertV2Attr = false;
      let digestOid = '2.16.840.1.101.3.4.2.1';

      const rawCapture = p7.rawCapture || {};
      if (rawCapture.digestAlgorithm) {
        try {
          digestOid = forge.asn1.derToOid(rawCapture.digestAlgorithm);
        } catch {}
      }

      const authAttrs: any[] = rawCapture.authenticatedAttributes || [];
      for (const attrAsn1 of authAttrs) {
        if (!attrAsn1.value || attrAsn1.value.length < 2) continue;
        const oid = forge.asn1.derToOid(attrAsn1.value[0].value);
        const attrSet = attrAsn1.value[1];
        const firstVal = attrSet?.value?.[0];

        if (oid === forge.pki.oids.messageDigest && firstVal) {
          extractedDigestBytes = firstVal.value;
        } else if (oid === forge.pki.oids.signingTime && firstVal) {
          try {
            signingTime = forge.asn1.utcTimeToDate(firstVal.value);
          } catch {
            try {
              signingTime = forge.asn1.generalizedTimeToDate(firstVal.value);
            } catch {}
          }
        } else if (
          oid === '1.2.840.113549.1.9.16.2.47' ||
          oid === '1.2.840.113549.1.9.16.2.12'
        ) {
          hasPAdESCertV2Attr = true;
        }
      }

      const useSha1 = digestOid === forge.pki.oids.sha1;
      const md = useSha1 ? forge.md.sha1.create() : forge.md.sha256.create();
      const range1 = decoder.decode(pdfBytes.subarray(o1, o1 + l1));
      const range2 = decoder.decode(pdfBytes.subarray(o2, o2 + l2));
      md.update(range1, 'raw');
      md.update(range2, 'raw');
      const computedDigestBytes = md.digest().getBytes();

      const isIntegrityValid =
        extractedDigestBytes !== null && computedDigestBytes === extractedDigestBytes;

      const notBefore = signerCert ? signerCert.validity.notBefore : new Date(0);
      const notAfter = signerCert ? signerCert.validity.notAfter : new Date(0);
      const checkDate = signingTime || new Date();
      const isWithinValidityPeriod = checkDate >= notBefore && checkDate <= notAfter;
      const coversWholeDocument = o2 + l2 === pdfBytes.length;

      results.push({
        index: sigIndex,
        subFilter,
        signerName,
        signerNif: signerNif || 'Incluido en Sujeto DN',
        issuerName,
        serialNumberHex: signerCert?.serialNumber?.toUpperCase() || 'N/A',
        signingTime,
        notBefore,
        notAfter,
        isIntegrityValid,
        isWithinValidityPeriod,
        hasPAdESCertV2Attr,
        digestAlgorithm: useSha1 ? 'SHA-1' : 'SHA-256',
        byteRange: [o1, l1, o2, l2],
        coversWholeDocument,
        documentSha256Preview: docHashPreview,
      });
    }

    return results;
  }

  function renderReport(fileName: string, signatures: ParsedSignatureInfo[]) {
    statusBox.classList.add('hidden');
    reportContainer.classList.remove('hidden');
    signaturesList.innerHTML = '';

    summaryBanner.className =
      'rounded-xl p-5 border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4';

    if (signatures.length === 0) {
      summaryBanner.classList.add('bg-amber-50', 'border-amber-300', 'text-amber-950');
      summaryTitle.innerHTML = '<span>⚠️</span> Documento PDF Sin Firma Criptográfica';
      summaryDesc.textContent = `El archivo "${fileName}" no contiene ningún diccionario de firma digital (/ByteRange / PKCS#7). Si tiene un garabato o imagen pegada, se trata solo de un dibujo sin validez criptográfica.`;
      summaryBadge.className =
        'px-3.5 py-1.5 rounded-full text-xs font-bold bg-amber-200 text-amber-900 shrink-0';
      summaryBadge.textContent = 'NO FIRMADO';
      return;
    }

    const allValid = signatures.every((s) => s.isIntegrityValid && s.isWithinValidityPeriod);

    if (allValid) {
      summaryBanner.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-950');
      summaryTitle.innerHTML = `<span>✅</span> Firma Digital Válida e Íntegra (${signatures.length} ${signatures.length === 1 ? 'firma detectada' : 'firmas detectadas'})`;
      summaryDesc.textContent = `El resumen criptográfico coincide exactamente con el contenido del PDF. El documento no ha sido modificado desde su firma y cumple con el estándar europeo eIDAS.`;
      summaryBadge.className =
        'px-3.5 py-1.5 rounded-full text-xs font-bold bg-emerald-200 text-emerald-900 shrink-0';
      summaryBadge.textContent = 'VÁLIDO · eIDAS';
    } else {
      summaryBanner.classList.add('bg-red-50', 'border-red-300', 'text-red-950');
      summaryTitle.innerHTML = '<span>❌</span> Advertencia en la Validación Criptográfica';
      summaryDesc.textContent =
        'Al menos una firma presenta alteraciones en el ByteRange o el certificado se encontraba fuera de su periodo de vigencia.';
      summaryBadge.className =
        'px-3.5 py-1.5 rounded-full text-xs font-bold bg-red-200 text-red-900 shrink-0';
      summaryBadge.textContent = 'REVISIÓN REQUERIDA';
    }

    signatures.forEach((sig) => {
      const card = document.createElement('div');
      card.className = 'border border-slate-200 rounded-xl p-5 bg-white shadow-2xs space-y-4';

      const dateFormatted = sig.signingTime
        ? sig.signingTime.toLocaleString('es-ES', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
          }) + ' UTC'
        : 'No especificada en atributos CMS';

      const validityFormatted = `${sig.notBefore.toLocaleDateString('es-ES')} → ${sig.notAfter.toLocaleDateString('es-ES')}`;

      card.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-100">
          <div class="flex items-center gap-2">
            <span class="w-7 h-7 rounded-lg bg-blue-100 text-blue-800 font-bold text-xs flex items-center justify-center">
              #${sig.index}
            </span>
            <div>
              <h3 class="text-sm font-bold text-slate-900">${sig.signerName}</h3>
              <p class="text-xs text-slate-500">NIF / Identificador: <strong>${sig.signerNif}</strong></p>
            </div>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold ${
              sig.isIntegrityValid
                ? 'bg-emerald-100 text-emerald-800'
                : 'bg-red-100 text-red-800'
            }">
              ${sig.isIntegrityValid ? '✓ Integridad SHA-256 Intacta' : '✗ Documento Alterado'}
            </span>
            <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-slate-100 text-slate-700">
              ${sig.subFilter}
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-xs">
          <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
            <span class="text-slate-400 font-semibold block uppercase text-[10px]">Autoridad Emisora (CA)</span>
            <span class="text-slate-800 font-bold mt-0.5 block">${sig.issuerName}</span>
          </div>
          <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
            <span class="text-slate-400 font-semibold block uppercase text-[10px]">Fecha y Hora de Firma</span>
            <span class="text-slate-800 font-bold mt-0.5 block">${dateFormatted}</span>
          </div>
          <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
            <span class="text-slate-400 font-semibold block uppercase text-[10px]">Vigencia del Certificado</span>
            <span class="text-slate-800 font-bold mt-0.5 block">${validityFormatted}</span>
          </div>
          <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
            <span class="text-slate-400 font-semibold block uppercase text-[10px]">Estándar ETSI PAdES</span>
            <span class="text-slate-800 font-bold mt-0.5 block">
              ${sig.hasPAdESCertV2Attr ? 'PAdES-B-B (ESSCertIDv2 verificado)' : 'PKCS#7 / CMS Estándar'}
            </span>
          </div>
          <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
            <span class="text-slate-400 font-semibold block uppercase text-[10px]">Algoritmo y Cobertura</span>
            <span class="text-slate-800 font-bold mt-0.5 block">
              ${sig.digestAlgorithm} · ${sig.coversWholeDocument ? '100% del archivo' : 'Firma parcial / incremental'}
            </span>
          </div>
          <div class="bg-slate-50 p-3 rounded-lg border border-slate-100">
            <span class="text-slate-400 font-semibold block uppercase text-[10px]">Huella SHA-256 (Prefijo)</span>
            <span class="text-slate-800 font-mono text-[11px] mt-0.5 block">${sig.documentSha256Preview}...</span>
          </div>
        </div>
      `;

      signaturesList.appendChild(card);
    });
  }

  async function processPdfFile(file: File) {
    titleEl.textContent = `📄 ${file.name}`;
    subEl.textContent = `${(file.size / 1024).toFixed(1)} KB · Auditando estructura criptográfica...`;
    reportContainer.classList.add('hidden');
    showStatus('🔍 Extrayendo diccionario /ByteRange y verificando resumen criptográfico...', 'info');

    try {
      const buffer = await file.arrayBuffer();
      const signatures = await inspectPdfSignatures(buffer);
      renderReport(file.name, signatures);
    } catch (err: any) {
      showStatus(
        `❌ Error al analizar la estructura criptográfica del PDF: ${err?.message || 'Formato desconocido.'}`,
        'error'
      );
    }
  }

  fileInput?.addEventListener('change', () => {
    if (fileInput.files?.[0]) processPdfFile(fileInput.files[0]);
  });

  dropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-blue-600', 'bg-blue-50/50');
  });

  dropzone?.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-blue-600', 'bg-blue-50/50');
  });

  dropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-blue-600', 'bg-blue-50/50');
    const file = e.dataTransfer?.files?.[0];
    if (file) processPdfFile(file);
  });
</script>
