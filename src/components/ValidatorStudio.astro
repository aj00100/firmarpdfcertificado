---
// src/components/ValidatorStudio.astro
---

<div class="bg-white rounded-2xl shadow-xl border border-slate-200 overflow-hidden">
  <!-- Dropzone Principal -->
  <div id="validator-dropzone" class="print:hidden p-8 md:p-12 text-center border-2 border-dashed border-slate-300 hover:border-slate-500 rounded-xl m-4 transition-all cursor-pointer bg-slate-50/70 hover:bg-slate-100/50">
    <input type="file" id="pdf-audit-input" accept="application/pdf,.pdf" class="hidden" />
    
    <div class="w-16 h-16 rounded-2xl bg-slate-900 text-slate-100 flex items-center justify-center mx-auto mb-4 shadow-md">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="m9 12 2 2 4-4"/>
      </svg>
    </div>

    <h2 class="text-xl md:text-2xl font-bold text-slate-900 mb-2">
      Arrastra aquí el archivo PDF que deseas inspeccionar
    </h2>
    <p class="text-slate-500 text-sm max-w-lg mx-auto mb-6">
      Inspector criptográfico local de firmas PAdES y PKCS#7. Análisis de rangos /ByteRange y verificación matemática en la memoria RAM de tu navegador, sin enviar datos a ningún servidor.
    </p>

    <button type="button" id="select-pdf-btn" class="bg-slate-900 hover:bg-slate-800 text-white font-semibold px-6 py-3 rounded-xl text-sm shadow transition-colors inline-flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="17 8 12 3 7 8"/>
        <line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      Seleccionar documento PDF
    </button>
  </div>

  <!-- Panel de Resultados de Auditoría (Oculto por defecto) -->
  <div id="audit-results-panel" class="hidden border-t border-slate-200 p-6 md:p-8 bg-white">
    <!-- Aviso Exclusivo para Impresión / Informe PDF Físico -->
    <div class="hidden print:block p-4 mb-4 border border-slate-300 rounded bg-slate-50 text-[10px] text-slate-700 leading-relaxed">
      <strong>INFORME DE INSPECCIÓN CRIPTOGRÁFICA LOCAL (SIN SUBIR ARCHIVOS)</strong><br />
      Este informe refleja exclusivamente la comprobación matemática local de la firma (integridad de bytes y clave pública) ejecutada en el navegador del usuario. No constituye una validación jurídica oficial de certificado (eIDAS / LOTL / TSL) ni comprueba el estado de revocación en tiempo real (OCSP / CRL). Para efectos legales o administrativos vinculantes, utilice pasarelas oficiales como VALIDe (valide.redsara.es) o software con conexión a listas de confianza oficiales.
    </div>

    <!-- Cabecera del archivo analizado -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-6 border-b border-slate-200">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-700 font-bold text-xs">
          PDF
        </div>
        <div>
          <h3 id="audit-filename" class="font-bold text-slate-900 text-base break-all">documento.pdf</h3>
          <p id="audit-filemeta" class="text-xs text-slate-500">Tamaño: 0 KB · Hash SHA-256 del archivo calculado</p>
        </div>
      </div>

      <div class="flex items-center gap-2 print:hidden">
        <button type="button" id="print-audit-btn" class="text-xs font-semibold px-3.5 py-2 rounded-lg border border-slate-300 text-slate-700 hover:bg-slate-100 transition-colors">
          Imprimir Informe
        </button>
        <button type="button" id="reset-audit-btn" class="text-xs font-semibold px-3.5 py-2 rounded-lg bg-slate-900 text-white hover:bg-slate-800 transition-colors">
          Analizar otro PDF
        </button>
      </div>
    </div>

    <!-- Banner de Estado General -->
    <div id="audit-status-banner" class="mt-6 p-5 rounded-xl border flex items-start gap-4">
      <div id="audit-status-icon" class="shrink-0 mt-0.5"></div>
      <div>
        <h4 id="audit-status-title" class="font-extrabold text-lg"></h4>
        <p id="audit-status-desc" class="text-sm mt-1 leading-relaxed"></p>
      </div>
    </div>

    <!-- Contenedor de Tarjetas de Firmas Encontradas -->
    <div id="signatures-list" class="mt-6 space-y-6"></div>

    <!-- Aviso de Limitación Técnica y Comparativa con VALIDe -->
    <div class="mt-8 p-5 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 space-y-2">
      <div class="flex items-center gap-2 font-bold text-slate-800 text-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
        Alcance de la Inspección Criptográfica y Límites Técnicos
      </div>
      <p class="leading-relaxed">
        <strong>Inspección Criptográfica de Bytes (No Analizador de Estructura PDF):</strong> Este inspector analiza exclusivamente la integridad matemática de los bloques PKCS#7 / CAdES y los rangos /ByteRange en memoria RAM local. No analiza la tabla xref ni el árbol de objetos PDF del documento, por lo que este análisis se limita a la integridad de los rangos de bytes detectados y no sustituye a los validadores oficiales estatales (<a href="https://valide.redsara.es" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline font-semibold hover:text-blue-800">VALIDe</a>) ni al motor de Adobe Acrobat.
      </p>
      <p class="leading-relaxed">
        <strong>Verificación Matemática Local:</strong> Comprueba en la memoria de tu navegador que el resumen criptográfico del archivo coincide con el atributo <code>messageDigest</code> firmado y que la firma matemática (RSA o ECDSA) es válida para la clave pública del certificado incrustado.
      </p>
      <p class="leading-relaxed">
        <strong>Límite de Confianza e Identidad (eIDAS / TSL):</strong> La identidad mostrada corresponde a la declarada en el certificado del archivo. Para contrastar si el certificado ha sido revocado en tiempo real (OCSP/CRL) o si la Autoridad de Certificación está acreditada en la lista europea TSL, se requiere consulta externa a prestadores cualificados.
      </p>
      <p class="leading-relaxed">
        <strong>Validación Oficial Estatal:</strong> Para trámites judiciales o administrativos con requerimiento de informe oficial vinculante, recomendamos contrastar el documento en la pasarela oficial <a href="https://valide.redsara.es" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline font-semibold hover:text-blue-800">VALIDe (valide.redsara.es)</a>. <em>Aviso de privacidad: VALIDe procesa el archivo en servidores de la Administración General del Estado, mientras que este inspector opera 100% en tu navegador.</em>
      </p>
    </div>

    <!-- Pie de Página Exclusivo para Impresión -->
    <div class="hidden print:block mt-6 pt-4 border-t border-slate-300 text-[9px] text-slate-500">
      Inspección criptográfica generada en la memoria local del navegador web mediante la API Web Crypto. No se subió ningún archivo PDF para su procesamiento.
    </div>
  </div>
</div>

<script>
  import { trackEvent } from '../utils/telemetry';

  trackEvent('tool_view', { studio: 'validator' });

  // Diccionario de OIDs estándar X.509 / PKCS#7 / PAdES
  const OID_MAP: Record<string, string> = {
    "2.5.4.3": "CN",
    "2.5.4.4": "SN",
    "2.5.4.5": "serialNumber",
    "2.5.4.6": "C",
    "2.5.4.10": "O",
    "2.5.4.11": "OU",
    "2.5.4.42": "GN",
    "2.5.4.97": "organizationIdentifier",
    "1.2.840.113549.1.9.3": "contentType",
    "1.2.840.113549.1.9.4": "messageDigest",
    "1.2.840.113549.1.9.5": "signingTime",
    "1.2.840.113549.1.9.16.2.47": "signingCertificateV2",
    "2.16.840.1.101.3.4.2.1": "SHA-256",
    "1.3.14.3.2.26": "SHA-1",
    "2.16.840.1.101.3.4.2.2": "SHA-384",
    "2.16.840.1.101.3.4.2.3": "SHA-512",
    "1.2.840.113549.1.1.1": "rsaEncryption",
    "1.2.840.113549.1.1.5": "sha1WithRSAEncryption",
    "1.2.840.113549.1.1.11": "sha256WithRSAEncryption",
    "1.2.840.113549.1.1.12": "sha384WithRSAEncryption",
    "1.2.840.113549.1.1.13": "sha512WithRSAEncryption",
    "1.2.840.113549.1.1.10": "rsassa-pss",
    "1.2.840.10045.2.1": "id-ecPublicKey",
    "1.2.840.10045.3.1.7": "secp256r1 (P-256)",
    "1.3.132.0.34": "secp384r1 (P-384)",
    "1.3.132.0.35": "secp521r1 (P-521)",
    "1.2.840.10045.4.3.2": "ecdsa-with-SHA256",
    "1.2.840.10045.4.3.3": "ecdsa-with-SHA384",
    "1.2.840.10045.4.3.4": "ecdsa-with-SHA512"
  };

  const OID_HASH: Record<string, string> = {
    "1.3.14.3.2.26": "SHA-1",
    "2.16.840.1.101.3.4.2.1": "SHA-256",
    "2.16.840.1.101.3.4.2.2": "SHA-384",
    "2.16.840.1.101.3.4.2.3": "SHA-512"
  };

  interface Asn1Node {
    tag: number;
    headerLen: number;
    length: number;
    start: number;
    valueStart: number;
    isIndefinite?: boolean;
    children?: Asn1Node[];
  }

  // Decodificador ASN.1 DER/BER ligero en memoria (soporta longitud definida e indefinida 0x80)
  function parseAsn1(bytes: Uint8Array, offset = 0, maxOffset = bytes.length): Asn1Node | null {
    if (offset >= maxOffset) return null;
    const start = offset;
    const tag = bytes[offset++];
    if (offset >= maxOffset) return null;

    let isIndefinite = false;
    let length = bytes[offset++];
    if (length === 0x80) {
      isIndefinite = true;
      length = 0;
    } else if (length & 0x80) {
      const numBytes = length & 0x7f;
      if (numBytes === 0 || numBytes > 4 || offset + numBytes > maxOffset) return null;
      length = 0;
      for (let i = 0; i < numBytes; i++) {
        length = (length << 8) | bytes[offset++];
      }
    }

    const valueStart = offset;
    const headerLen = valueStart - start;
    if (!isIndefinite && valueStart + length > maxOffset) return null;

    const node: Asn1Node = { tag, headerLen, length, start, valueStart, isIndefinite };
    const isConstructed = (tag & 0x20) !== 0;

    if (isConstructed) {
      node.children = [];
      let childOffset = valueStart;
      const end = isIndefinite ? maxOffset : valueStart + length;
      while (childOffset < end) {
        if (bytes[childOffset] === 0x00 && bytes[childOffset + 1] === 0x00) {
          childOffset += 2;
          break;
        }
        const child = parseAsn1(bytes, childOffset, end);
        if (!child) break;
        node.children.push(child);
        childOffset = child.valueStart + child.length;
      }
      if (isIndefinite) {
        node.length = childOffset - valueStart;
      }
    }

    return node;
  }

  function decodeOid(bytes: Uint8Array, node: Asn1Node): string {
    const slice = bytes.subarray(node.valueStart, node.valueStart + node.length);
    if (slice.length === 0) return "";
    const parts = [Math.floor(slice[0] / 40), slice[0] % 40];
    let value = 0;
    for (let i = 1; i < slice.length; i++) {
      value = (value << 7) | (slice[i] & 0x7f);
      if ((slice[i] & 0x80) === 0) {
        parts.push(value);
        value = 0;
      }
    }
    return parts.join(".");
  }

  function decodeAsn1String(bytes: Uint8Array, node: Asn1Node): string {
    const slice = bytes.subarray(node.valueStart, node.valueStart + node.length);
    if (node.tag === 0x1e) {
      let out = "";
      for (let i = 0; i < slice.length; i += 2) {
        out += String.fromCharCode((slice[i] << 8) | slice[i + 1]);
      }
      return out.trim();
    }
    return new TextDecoder("utf-8", { fatal: false }).decode(slice).trim();
  }

  function decodeAsn1Time(bytes: Uint8Array, node: Asn1Node): Date | null {
    const raw = decodeAsn1String(bytes, node);
    if (node.tag === 0x17 && raw.length >= 10) {
      const yy = parseInt(raw.slice(0, 2), 10);
      const year = yy >= 50 ? 1900 + yy : 2000 + yy;
      const month = parseInt(raw.slice(2, 4), 10) - 1;
      const day = parseInt(raw.slice(4, 6), 10);
      const hour = parseInt(raw.slice(6, 8), 10);
      const min = parseInt(raw.slice(8, 10), 10);
      return new Date(Date.UTC(year, month, day, hour, min));
    }
    if (node.tag === 0x18 && raw.length >= 12) {
      const year = parseInt(raw.slice(0, 4), 10);
      const month = parseInt(raw.slice(4, 6), 10) - 1;
      const day = parseInt(raw.slice(6, 8), 10);
      const hour = parseInt(raw.slice(8, 10), 10);
      const min = parseInt(raw.slice(10, 12), 10);
      return new Date(Date.UTC(year, month, day, hour, min));
    }
    return null;
  }

  function parsePdfDate(raw: string): Date | null {
    const clean = raw.replace(/^D:/, "").trim();
    const m = clean.match(/^(\d{4})(\d{2})(\d{2})(\d{2})?(\d{2})?(\d{2})?(?:([+-Z])(\d{2})?'?(\d{2})?'?)?/);
    if (!m) return null;
    const year = parseInt(m[1], 10);
    const month = parseInt(m[2], 10) - 1;
    const day = parseInt(m[3], 10);
    const hour = m[4] ? parseInt(m[4], 10) : 0;
    const min = m[5] ? parseInt(m[5], 10) : 0;
    const sec = m[6] ? parseInt(m[6], 10) : 0;
    const tzSign = m[7];
    let tzOffsetMinutes = 0;
    if (tzSign === "+" || tzSign === "-") {
      const tzHour = m[8] ? parseInt(m[8], 10) : 0;
      const tzMin = m[9] ? parseInt(m[9], 10) : 0;
      tzOffsetMinutes = (tzHour * 60 + tzMin) * (tzSign === "+" ? 1 : -1);
    }
    const utcMillis = Date.UTC(year, month, day, hour, min, sec) - (tzOffsetMinutes * 60 * 1000);
    return new Date(utcMillis);
  }

  function getRsaKeyBits(spkiBytes: Uint8Array): number | null {
    const root = parseAsn1(spkiBytes);
    if (!root || !root.children || root.children.length < 2) return null;
    const bitStringNode = root.children[1];
    if (bitStringNode.tag !== 0x03) return null;
    const rsaPkDer = spkiBytes.subarray(bitStringNode.valueStart + 1, bitStringNode.valueStart + bitStringNode.length);
    const rsaSeq = parseAsn1(rsaPkDer);
    if (!rsaSeq || !rsaSeq.children || rsaSeq.children.length < 2) return null;
    const modNode = rsaSeq.children[0];
    if (modNode.tag !== 0x02) return null;
    let modLen = modNode.length;
    if (rsaPkDer[modNode.valueStart] === 0x00) modLen--;
    return modLen * 8;
  }

  function extractRDNMap(bytes: Uint8Array, nameNode: Asn1Node): Record<string, string> {
    const map: Record<string, string> = {};
    if (!nameNode.children) return map;
    for (const rdnSet of nameNode.children) {
      if (!rdnSet.children) continue;
      for (const atv of rdnSet.children) {
        if (atv.children && atv.children.length >= 2 && atv.children[0].tag === 0x06) {
          const oid = decodeOid(bytes, atv.children[0]);
          const key = OID_MAP[oid] || oid;
          const val = decodeAsn1String(bytes, atv.children[1]);
          map[key] = val;
        }
      }
    }
    return map;
  }

  function hexToBytes(hex: string): Uint8Array {
    const clean = hex.replace(/[^0-9A-Fa-f]/g, "");
    const fullLen = Math.floor(clean.length / 2);
    const raw = new Uint8Array(fullLen);
    for (let i = 0; i < fullLen; i++) {
      raw[i] = parseInt(clean.slice(i * 2, i * 2 + 2), 16);
    }
    const root = parseAsn1(raw);
    if (root && root.start === 0 && !root.isIndefinite) {
      const exactDerLen = root.headerLen + root.length;
      if (exactDerLen <= raw.length) {
        return raw.subarray(0, exactDerLen);
      }
    }
    return raw;
  }

  function toHex(bytes: Uint8Array): string {
    return Array.from(bytes).map(b => b.toString(16).padStart(2, "0")).join("");
  }

  interface ExtractedCert {
    serialHex: string;
    rawDer: Uint8Array;
    spkiBytes: Uint8Array;
    keyAlgoOid: string;
    curveOid: string;
    issuerMap: Record<string, string>;
    subjectMap: Record<string, string>;
    validFrom: Date | null;
    validTo: Date | null;
    tbsDer: Uint8Array;
    certSigAlgoOid: string;
    certSigBytes: Uint8Array;
    isSelfSignedSubjectIssuer: boolean;
    selfSignatureVerified: boolean | null;
    rsaKeyBits: number | null;
  }

  interface ExtractedSignerInfo {
    isDocTimeStamp: boolean;
    tstMessageImprintHex: string;
    tstHashAlgo: string;
    sidSerialHex: string;
    digestOid: string;
    digestAlgorithm: string;
    sigAlgoOid: string;
    messageDigestHex: string;
    signingTime: Date | null;
    hasPadesEssCertIdV2: boolean;
    essCertHashHex: string;
    essCertHashAlgo: string;
    taggedAttrs: Uint8Array;
    sigBytes: Uint8Array;
  }

  // Extracción exhaustiva de certificados y firmantes CMS
  function inspectCmsFull(cmsBytes: Uint8Array): { certs: ExtractedCert[]; signerInfos: ExtractedSignerInfo[] } | null {
    const root = parseAsn1(cmsBytes);
    if (!root) return null;

    let isDocTimeStamp = false;
    let tstMessageImprintHex = "";
    let tstHashAlgo = "SHA-256";

    // Detectar si el contenedor CMS corresponde a un Sello de Tiempo RFC 3161 (DocTimeStamp PAdES-LTA)
    try {
      const signedData = root.children && root.children[1]?.children ? root.children[1].children[0] : null;
      if (signedData && signedData.children && signedData.children.length >= 3) {
        const encap = signedData.children[2];
        if (encap.children && encap.children[0]?.tag === 0x06) {
          if (decodeOid(cmsBytes, encap.children[0]) === "1.2.840.113549.1.9.16.1.4") {
            isDocTimeStamp = true;
            const eContentNode = encap.children[1];
            let tstDer = cmsBytes.subarray(eContentNode.valueStart, eContentNode.valueStart + eContentNode.length);
            const innerRoot = parseAsn1(tstDer);
            let tstNode = innerRoot;
            if (innerRoot && innerRoot.tag === 0x04) {
              tstNode = parseAsn1(tstDer.subarray(innerRoot.valueStart, innerRoot.valueStart + innerRoot.length));
              tstDer = tstDer.subarray(innerRoot.valueStart, innerRoot.valueStart + innerRoot.length);
            }
            if (tstNode && tstNode.children && tstNode.children.length >= 3) {
              const imprint = tstNode.children[2];
              if (imprint.children && imprint.children.length >= 2) {
                const algNode = imprint.children[0];
                const octNode = imprint.children[1];
                if (algNode.children && algNode.children[0]?.tag === 0x06) {
                  const algOid = decodeOid(tstDer, algNode.children[0]);
                  if (OID_HASH[algOid]) tstHashAlgo = OID_HASH[algOid];
                }
                if (octNode.tag === 0x04) {
                  tstMessageImprintHex = toHex(tstDer.subarray(octNode.valueStart, octNode.valueStart + octNode.length));
                }
              }
            }
          }
        }
      }
    } catch {}

    const certs: ExtractedCert[] = [];
    const signerInfos: ExtractedSignerInfo[] = [];

    function walk(node: Asn1Node) {
      // 1. Detectar certificados X.509 (Certificate SEQUENCE -> [tbsCertificate, sigAlgo, sigVal])
      if (
        node.tag === 0x30 &&
        node.children &&
        node.children.length === 3 &&
        node.children[0].tag === 0x30 &&
        node.children[0].children &&
        node.children[0].children.length >= 6 &&
        node.children[0].children[0].tag === 0xa0 && // Version [0]
        node.children[0].children[1].tag === 0x02    // SerialNumber INTEGER
      ) {
        const tbs = node.children[0];
        const rawDer = cmsBytes.subarray(node.start, node.start + node.headerLen + node.length);
        const serialNode = tbs.children[1];
        const serialHex = toHex(cmsBytes.subarray(serialNode.valueStart, serialNode.valueStart + serialNode.length));
        const spkiNode = tbs.children[6];
        const spkiBytes = cmsBytes.subarray(spkiNode.start, spkiNode.start + spkiNode.headerLen + spkiNode.length);

        let keyAlgoOid = "";
        let curveOid = "";
        if (spkiNode.children && spkiNode.children[0]?.children) {
          const algId = spkiNode.children[0];
          if (algId.children[0]?.tag === 0x06) {
            keyAlgoOid = decodeOid(cmsBytes, algId.children[0]);
          }
          if (algId.children[1]?.tag === 0x06) {
            curveOid = decodeOid(cmsBytes, algId.children[1]);
          }
        }

        const issuerMap = extractRDNMap(cmsBytes, tbs.children[3]);
        const subjectMap = extractRDNMap(cmsBytes, tbs.children[5]);
        let validFrom: Date | null = null;
        let validTo: Date | null = null;
        if (tbs.children[4].children && tbs.children[4].children.length >= 2) {
          validFrom = decodeAsn1Time(cmsBytes, tbs.children[4].children[0]);
          validTo = decodeAsn1Time(cmsBytes, tbs.children[4].children[1]);
        }

        const tbsDer = cmsBytes.subarray(tbs.start, tbs.start + tbs.headerLen + tbs.length);
        let certSigAlgoOid = "";
        if (node.children[1].children && node.children[1].children[0]?.tag === 0x06) {
          certSigAlgoOid = decodeOid(cmsBytes, node.children[1].children[0]);
        }
        const certSigNode = node.children[2];
        const certSigBytes = (certSigNode.length > 1)
          ? cmsBytes.subarray(certSigNode.valueStart + 1, certSigNode.valueStart + certSigNode.length)
          : new Uint8Array();

        // Check if subject DN === issuer DN
        const issuerDer = cmsBytes.subarray(tbs.children[3].start, tbs.children[3].start + tbs.children[3].headerLen + tbs.children[3].length);
        const subjectDer = cmsBytes.subarray(tbs.children[5].start, tbs.children[5].start + tbs.children[5].headerLen + tbs.children[5].length);
        let dnDerMatch = (issuerDer.length === subjectDer.length);
        if (dnDerMatch) {
          for (let i = 0; i < issuerDer.length; i++) {
            if (issuerDer[i] !== subjectDer[i]) { dnDerMatch = false; break; }
          }
        }
        const dnKeysI = Object.keys(issuerMap);
        const dnKeysS = Object.keys(subjectMap);
        const dnStringMatch = dnKeysI.length > 0 && dnKeysI.length === dnKeysS.length && dnKeysI.every(k => issuerMap[k] === subjectMap[k]);
        const isSelfSignedSubjectIssuer = dnDerMatch || dnStringMatch;
        const rsaKeyBits = (keyAlgoOid === "1.2.840.113549.1.1.1" && spkiBytes.length > 0) ? getRsaKeyBits(spkiBytes) : null;

        certs.push({
          serialHex,
          rawDer,
          spkiBytes,
          keyAlgoOid,
          curveOid,
          issuerMap,
          subjectMap,
          validFrom,
          validTo,
          tbsDer,
          certSigAlgoOid,
          certSigBytes,
          isSelfSignedSubjectIssuer,
          selfSignatureVerified: null,
          rsaKeyBits
        });
      }

      // 2. Detectar SignerInfo
      if (node.tag === 0x30 && node.children && node.children.length >= 5) {
        if (node.children[0].tag === 0x02 && (node.children[1].tag === 0x30 || node.children[1].tag === 0x80)) {
          const sidNode = node.children[1];
          let sidSerialHex = "";
          if (sidNode.tag === 0x30 && sidNode.children && sidNode.children.length >= 2) {
            const sNode = sidNode.children[1];
            sidSerialHex = toHex(cmsBytes.subarray(sNode.valueStart, sNode.valueStart + sNode.length));
          }

          const digestAlgoNode = node.children[2];
          let digestOid = "";
          if (digestAlgoNode.children && digestAlgoNode.children[0]?.tag === 0x06) {
            digestOid = decodeOid(cmsBytes, digestAlgoNode.children[0]);
          }

          let signedAttrsNode: Asn1Node | null = null;
          let sigAlgoNode: Asn1Node | null = null;
          let sigValueNode: Asn1Node | null = null;
          for (let i = 3; i < node.children.length; i++) {
            const c = node.children[i];
            if (c.tag === 0xa0 && !signedAttrsNode) signedAttrsNode = c;
            else if (c.tag === 0x30 && !sigAlgoNode) sigAlgoNode = c;
            else if (c.tag === 0x04 && !sigValueNode) sigValueNode = c;
          }

          let sigAlgoOid = "";
          if (sigAlgoNode && sigAlgoNode.children && sigAlgoNode.children[0]?.tag === 0x06) {
            sigAlgoOid = decodeOid(cmsBytes, sigAlgoNode.children[0]);
          }

          if (signedAttrsNode && sigValueNode) {
            let messageDigestHex = "";
            let signingTime: Date | null = null;
            let hasPadesEssCertIdV2 = false;
            let essCertHashHex = "";
            let essCertHashAlgo = "SHA-256";

            if (signedAttrsNode.children) {
              for (const attr of signedAttrsNode.children) {
                if (attr.tag === 0x30 && attr.children && attr.children.length >= 2 && attr.children[0].tag === 0x06) {
                  const oid = decodeOid(cmsBytes, attr.children[0]);
                  if (oid === "1.2.840.113549.1.9.4") {
                    const setNode = attr.children[1];
                    if (setNode.children && setNode.children[0]?.tag === 0x04 && !messageDigestHex) {
                      const oct = setNode.children[0];
                      messageDigestHex = toHex(cmsBytes.subarray(oct.valueStart, oct.valueStart + oct.length));
                    }
                  } else if (oid === "1.2.840.113549.1.9.5") {
                    const setNode = attr.children[1];
                    if (setNode.children && setNode.children[0]) {
                      signingTime = decodeAsn1Time(cmsBytes, setNode.children[0]);
                    }
                  } else if (oid === "1.2.840.113549.1.9.16.2.47") {
                    hasPadesEssCertIdV2 = true;
                    // RFC 5035 §3: The FIRST ESSCertIDv2 element identifies the certificate used to verify the signature.
                    function searchEssHash(n: Asn1Node) {
                      if (n.tag === 0x06 && !essCertHashHex) {
                        const hashOid = decodeOid(cmsBytes, n);
                        if (OID_HASH[hashOid]) essCertHashAlgo = OID_HASH[hashOid];
                      }
                      if (n.tag === 0x04 && [32, 48, 64].includes(n.length) && !essCertHashHex) {
                        essCertHashHex = toHex(cmsBytes.subarray(n.valueStart, n.valueStart + n.length));
                      }
                      if (n.children && !essCertHashHex) n.children.forEach(searchEssHash);
                    }
                    searchEssHash(attr.children[1]);
                  }
                }
              }
            }

            // Tag swap RFC 5652 §5.4: IMPLICIT [0] (0xA0) -> SET OF (0x31)
            const rawSignedAttrs = cmsBytes.subarray(
              signedAttrsNode.start,
              signedAttrsNode.start + signedAttrsNode.headerLen + signedAttrsNode.length
            );
            const taggedAttrs = new Uint8Array(rawSignedAttrs);
            taggedAttrs[0] = 0x31;

            const sigBytes = cmsBytes.subarray(
              sigValueNode.valueStart,
              sigValueNode.valueStart + sigValueNode.length
            );

            signerInfos.push({
              isDocTimeStamp,
              tstMessageImprintHex,
              tstHashAlgo,
              sidSerialHex,
              digestOid,
              digestAlgorithm: OID_HASH[digestOid] || "SHA-256",
              sigAlgoOid,
              messageDigestHex,
              signingTime,
              hasPadesEssCertIdV2,
              essCertHashHex,
              essCertHashAlgo,
              taggedAttrs,
              sigBytes
            });
          }
        }
      }

      if (node.children) node.children.forEach(walk);
    }

    walk(root);

    return { certs, signerInfos };
  }

  function inspectPkcs7Cms(cmsBytes: Uint8Array) {
    const data = inspectCmsFull(cmsBytes);
    const result = {
      subject: {} as Record<string, string>,
      issuer: {} as Record<string, string>,
      validFrom: null as Date | null,
      validTo: null as Date | null,
      messageDigestHex: "",
      signingTime: null as Date | null,
      hasPadesEssCertIdV2: false,
      digestAlgorithm: "SHA-256"
    };

    if (!data) return result;

    if (data.certs.length > 0) {
      const leafCert = data.certs[0];
      result.issuer = leafCert.issuerMap;
      result.subject = leafCert.subjectMap;
      result.validFrom = leafCert.validFrom;
      result.validTo = leafCert.validTo;
    }

    if (data.signerInfos.length > 0) {
      const si = data.signerInfos[0];
      result.messageDigestHex = si.messageDigestHex;
      result.signingTime = si.signingTime;
      result.hasPadesEssCertIdV2 = si.hasPadesEssCertIdV2;
      result.digestAlgorithm = si.digestAlgorithm;
    }

    return result;
  }

  interface AuditedSignature {
    index: number;
    byteRange: [number, number, number, number];
    rangeValidBounds: boolean;
    gapIntegrityValid: boolean;
    isLatestSignature: boolean;
    isHistoricalRevision: boolean;
    isEnclosedBySubsequent: boolean;
    coversEntireFile: boolean;
    calculatedRangeHashHex: string;
    hashMatches: boolean;
    mathSignatureValid: boolean | null;
    mathSignatureStatus: "VALID" | "INVALID" | "UNSUPPORTED_ALGORITHM" | "NOT_CHECKED";
    sigAlgorithmLabel: string;
    certHashMatches: boolean | null;
    certSubstitutionDetected: boolean;
    hasMalformedEssCert: boolean;
    sidMatched: boolean;
    isSha1: boolean;
    rsaKeyBits: number | null;
    isWeakRsaKey: boolean;
    pdfMDate: Date | null;
    matchedCert: ExtractedCert | null;
    signerInfo: ExtractedSignerInfo | null;
    cmsInfo: ReturnType<typeof inspectPkcs7Cms>;
  }

  async function auditPdfBuffer(file: { arrayBuffer: () => Promise<ArrayBuffer>; size?: number }) {
    const arrayBuffer = await file.arrayBuffer();
    const pdfBytes = new Uint8Array(arrayBuffer);
    const latin1Text = new TextDecoder("latin1").decode(pdfBytes);

    const fullDocHashBuf = await crypto.subtle.digest("SHA-256", pdfBytes);
    const fullDocHashHex = toHex(new Uint8Array(fullDocHashBuf));

    const byteRangeRegex = /\/ByteRange\s*\[\s*(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s*\]/g;
    const matches = [...latin1Text.matchAll(byteRangeRegex)];

    const signatures: AuditedSignature[] = [];

    // Inspección de cada firma presente
    for (let idx = 0; idx < matches.length; idx++) {
      const m = matches[idx];
      const b0 = parseInt(m[1], 10);
      const l0 = parseInt(m[2], 10);
      const b1 = parseInt(m[3], 10);
      const l1 = parseInt(m[4], 10);

      const isLatestSignature = (idx === matches.length - 1);
      const coversEntireFile = (b1 + l1 === pdfBytes.length);
      const rangeValidBounds = (b0 === 0 && b1 >= b0 + l0 && b1 + l1 <= pdfBytes.length);

      // Verificación de integridad del Gap /ByteRange (defensa contra signature wrapping y manipulación de /Contents)
      const beforeGap = latin1Text.slice(Math.max(0, l0 - 20), l0);
      const hasContentsPrefix = /\/Contents\s*$/.test(beforeGap);
      const gapSlice = latin1Text.slice(l0, b1);
      const startsWithLt = (gapSlice[0] === "<");
      const endsWithGt = (gapSlice[gapSlice.length - 1] === ">");
      const innerHex = gapSlice.slice(1, -1);
      const isOnlyHex = /^[0-9A-Fa-f\r\n\t\s]+$/.test(innerHex);
      const gapIntegrityValid = (b0 === 0 && hasContentsPrefix && startsWithLt && endsWithGt && isOnlyHex);

      let isHistoricalRevision = false;
      let isEnclosedBySubsequent = false;
      if (!isLatestSignature && matches[idx + 1]) {
        isHistoricalRevision = true;
        const nextB0 = parseInt(matches[idx + 1][1], 10);
        const nextEnd = parseInt(matches[idx + 1][3], 10) + parseInt(matches[idx + 1][4], 10);
        if (nextB0 === 0 && nextEnd > b1 + l1) {
          isEnclosedBySubsequent = true;
        }
      }

      const contentsRawSlice = latin1Text.slice(l0, b1);
      const hexMatch = contentsRawSlice.match(/<([0-9A-Fa-f\s]+)>/);
      let cmsBytes = new Uint8Array();
      if (hexMatch) {
        cmsBytes = hexToBytes(hexMatch[1]);
      }

      // Extraer fecha declarada en /M exclusivamente dentro del diccionario del /Contents actual
      let pdfMDate: Date | null = null;
      const dictStartIdx = latin1Text.lastIndexOf("<<", l0);
      const dictEndIdx = latin1Text.indexOf(">>", b1);
      if (dictStartIdx !== -1 && dictEndIdx !== -1 && dictEndIdx > dictStartIdx && (dictEndIdx - dictStartIdx) < 32768) {
        // Excluir el payload hexadecimal de /Contents para evitar señuelos dentro del bloque CMS
        const dictHeader = latin1Text.slice(dictStartIdx, l0);
        const dictFooter = latin1Text.slice(b1, dictEndIdx);
        const headerMatch = dictHeader.match(/\/M\s*\(([^)]+)\)/);
        const footerMatch = dictFooter.match(/\/M\s*\(([^)]+)\)/);
        const targetMatch = headerMatch || footerMatch;
        if (targetMatch) {
          pdfMDate = parsePdfDate(targetMatch[1]);
        }
      }

      const cmsData = inspectCmsFull(cmsBytes);
      const cmsInfo = inspectPkcs7Cms(cmsBytes);

      let calculatedRangeHashHex = "";
      let hashMatches = false;
      let mathSignatureValid: boolean | null = null;
      let mathSignatureStatus: "VALID" | "INVALID" | "UNSUPPORTED_ALGORITHM" | "NOT_CHECKED" = "NOT_CHECKED";
      let sigAlgorithmLabel = "RSA PKCS#1 v1.5";
      let certHashMatches: boolean | null = null;
      let certSubstitutionDetected = false;
      let hasMalformedEssCert = false;
      let sidMatched = false;
      let matchedCert: ExtractedCert | null = null;
      let signerInfo: ExtractedSignerInfo | null = null;
      let isSha1 = false;

      if (cmsData && cmsData.signerInfos.length > 0) {
        signerInfo = cmsData.signerInfos[0];
        isSha1 = (signerInfo.digestAlgorithm === "SHA-1");

        // Vincular certificado exacto por SignerIdentifier (sid serialNumber)
        const normSid = signerInfo.sidSerialHex.replace(/^0+/, "").toLowerCase();
        matchedCert = cmsData.certs.find(c => c.serialHex.replace(/^0+/, "").toLowerCase() === normSid) || null;
        if (matchedCert) {
          sidMatched = true;
        } else if (cmsData.certs.length > 0) {
          matchedCert = cmsData.certs[0];
        }

        if (matchedCert) {
          cmsInfo.subject = matchedCert.subjectMap;
          cmsInfo.issuer = matchedCert.issuerMap;
          cmsInfo.validFrom = matchedCert.validFrom;
          cmsInfo.validTo = matchedCert.validTo;

          // Verificación criptográfica de certificado autofirmado (Item 6)
          if (matchedCert.isSelfSignedSubjectIssuer && matchedCert.spkiBytes.length > 0 && matchedCert.certSigBytes.length > 0) {
            try {
              let certHashName = "SHA-256";
              if (matchedCert.certSigAlgoOid === "1.2.840.113549.1.1.5" || matchedCert.certSigAlgoOid === "1.2.840.10045.4.1") {
                certHashName = "SHA-1";
              } else if (matchedCert.certSigAlgoOid === "1.2.840.113549.1.1.12" || matchedCert.certSigAlgoOid === "1.2.840.10045.4.3.3") {
                certHashName = "SHA-384";
              } else if (matchedCert.certSigAlgoOid === "1.2.840.113549.1.1.13" || matchedCert.certSigAlgoOid === "1.2.840.10045.4.3.4") {
                certHashName = "SHA-512";
              }

              const isCertEcdsa = (matchedCert.keyAlgoOid === "1.2.840.10045.2.1" || matchedCert.certSigAlgoOid.startsWith("1.2.840.10045.4."));
              if (isCertEcdsa) {
                const curveMap: Record<string, { name: string; byteLen: number }> = {
                  "1.2.840.10045.3.1.7": { name: "P-256", byteLen: 32 },
                  "1.3.132.0.34": { name: "P-384", byteLen: 48 },
                  "1.3.132.0.35": { name: "P-521", byteLen: 66 }
                };
                const cInfo = curveMap[matchedCert.curveOid] || { name: "P-256", byteLen: 32 };
                const sigAsn1 = parseAsn1(matchedCert.certSigBytes);
                if (sigAsn1 && sigAsn1.children && sigAsn1.children.length >= 2) {
                  let rB = matchedCert.certSigBytes.subarray(sigAsn1.children[0].valueStart, sigAsn1.children[0].valueStart + sigAsn1.children[0].length);
                  let sB = matchedCert.certSigBytes.subarray(sigAsn1.children[1].valueStart, sigAsn1.children[1].valueStart + sigAsn1.children[1].length);
                  if (rB[0] === 0x00) rB = rB.subarray(1);
                  if (sB[0] === 0x00) sB = sB.subarray(1);
                  const p1363 = new Uint8Array(cInfo.byteLen * 2);
                  p1363.set(rB, cInfo.byteLen - rB.length);
                  p1363.set(sB, cInfo.byteLen * 2 - sB.length);

                  const pubKey = await crypto.subtle.importKey(
                    "spki",
                    matchedCert.spkiBytes,
                    { name: "ECDSA", namedCurve: cInfo.name },
                    false,
                    ["verify"]
                  );
                  matchedCert.selfSignatureVerified = await crypto.subtle.verify(
                    { name: "ECDSA", hash: { name: certHashName } },
                    pubKey,
                    p1363,
                    matchedCert.tbsDer
                  );
                } else {
                  matchedCert.selfSignatureVerified = false;
                }
              } else {
                const pubKey = await crypto.subtle.importKey(
                  "spki",
                  matchedCert.spkiBytes,
                  { name: "RSASSA-PKCS1-v1_5", hash: { name: certHashName } },
                  false,
                  ["verify"]
                );
                matchedCert.selfSignatureVerified = await crypto.subtle.verify(
                  "RSASSA-PKCS1-v1_5",
                  pubKey,
                  matchedCert.certSigBytes,
                  matchedCert.tbsDer
                );
              }
            } catch {
              matchedCert.selfSignatureVerified = false;
            }
          }

          // Verificación exhaustiva de SigningCertificateV2:
          // (a) Malformado -> fallo de verificación dura (hasMalformedEssCert = true)
          // (b) Ausente -> PKCS#7 clásico / sin ESSCertIDv2 (NUNCA sustitución ni malformado)
          // (c) Mismatch real -> Discrepancia en ESSCertIDv2 (posible sustitución)
          if (signerInfo.hasPadesEssCertIdV2) {
            if (!signerInfo.essCertHashHex) {
              // Caso (a): Atributo malformado o sin certHash extraíble
              certHashMatches = null;
              certSubstitutionDetected = false;
              hasMalformedEssCert = true;
            } else if (matchedCert.rawDer.length > 0) {
              try {
                const certDerHash = await crypto.subtle.digest(signerInfo.essCertHashAlgo || "SHA-256", matchedCert.rawDer);
                const calcCertHashHex = toHex(new Uint8Array(certDerHash));
                if (calcCertHashHex.toLowerCase() === signerInfo.essCertHashHex.toLowerCase()) {
                  certHashMatches = true;
                  certSubstitutionDetected = false;
                  hasMalformedEssCert = false;
                } else {
                  // Caso (c): Discrepancia real en el hash del certificado
                  certHashMatches = false;
                  certSubstitutionDetected = true;
                  hasMalformedEssCert = false;
                }
              } catch {
                certHashMatches = null;
                certSubstitutionDetected = false;
                hasMalformedEssCert = true;
              }
            }
          } else {
            // Caso (b): Atributo ausente
            certHashMatches = null;
            certSubstitutionDetected = false;
            hasMalformedEssCert = false;
          }
        }

        if (rangeValidBounds && gapIntegrityValid) {
          const signedBytes = new Uint8Array(l0 + l1);
          signedBytes.set(pdfBytes.subarray(b0, b0 + l0), 0);
          signedBytes.set(pdfBytes.subarray(b1, b1 + l1), l0);

          const expectedDigestHex = signerInfo.isDocTimeStamp ? signerInfo.tstMessageImprintHex : signerInfo.messageDigestHex;
          const hashAlgoToUse = signerInfo.isDocTimeStamp ? signerInfo.tstHashAlgo : signerInfo.digestAlgorithm;

          const digestBuf = await crypto.subtle.digest(hashAlgoToUse, signedBytes);
          calculatedRangeHashHex = toHex(new Uint8Array(digestBuf));
          hashMatches = (
            expectedDigestHex.length > 0 &&
            calculatedRangeHashHex.toLowerCase() === expectedDigestHex.toLowerCase()
          );

          // Identificación del algoritmo de clave y firma
          const keyAlgoOid = matchedCert?.keyAlgoOid || "";
          const curveOid = matchedCert?.curveOid || "";
          const sigAlgoOid = signerInfo.sigAlgoOid || "";

          const isRsaPss = (sigAlgoOid === "1.2.840.113549.1.1.10");
          const isEcdsa = (keyAlgoOid === "1.2.840.10045.2.1" || sigAlgoOid.startsWith("1.2.840.10045.4."));
          const isRsa = (keyAlgoOid === "1.2.840.113549.1.1.1" || (sigAlgoOid.startsWith("1.2.840.113549.1.1.") && !isRsaPss));

          if (isRsaPss) {
            sigAlgorithmLabel = "RSA-PSS";
            mathSignatureStatus = "UNSUPPORTED_ALGORITHM";
            mathSignatureValid = null;
          } else if (isEcdsa) {
            const curveMap: Record<string, { name: string; byteLen: number }> = {
              "1.2.840.10045.3.1.7": { name: "P-256", byteLen: 32 },
              "1.3.132.0.34": { name: "P-384", byteLen: 48 },
              "1.3.132.0.35": { name: "P-521", byteLen: 66 }
            };
            const curveInfo = curveMap[curveOid];
            if (!curveInfo) {
              sigAlgorithmLabel = `ECDSA (Curva no estándar ${curveOid || "N/A"})`;
              mathSignatureStatus = "UNSUPPORTED_ALGORITHM";
              mathSignatureValid = null;
            } else {
              sigAlgorithmLabel = `ECDSA (${curveInfo.name})`;
              try {
                // Conversión ASN.1 DER SEQUENCE { r INTEGER, s INTEGER } -> IEEE P1363 (r || s)
                const sigAsn1 = parseAsn1(signerInfo.sigBytes);
                if (sigAsn1 && sigAsn1.children && sigAsn1.children.length >= 2) {
                  const rNode = sigAsn1.children[0];
                  const sNode = sigAsn1.children[1];
                  let rBytes = signerInfo.sigBytes.subarray(rNode.valueStart, rNode.valueStart + rNode.length);
                  let sBytes = signerInfo.sigBytes.subarray(sNode.valueStart, sNode.valueStart + sNode.length);
                  if (rBytes[0] === 0x00) rBytes = rBytes.subarray(1);
                  if (sBytes[0] === 0x00) sBytes = sBytes.subarray(1);

                  const p1363 = new Uint8Array(curveInfo.byteLen * 2);
                  p1363.set(rBytes, curveInfo.byteLen - rBytes.length);
                  p1363.set(sBytes, curveInfo.byteLen * 2 - sBytes.length);

                  const pubKey = await crypto.subtle.importKey(
                    "spki",
                    matchedCert.spkiBytes,
                    { name: "ECDSA", namedCurve: curveInfo.name },
                    false,
                    ["verify"]
                  );
                  const ok = await crypto.subtle.verify(
                    { name: "ECDSA", hash: { name: signerInfo.digestAlgorithm } },
                    pubKey,
                    p1363,
                    signerInfo.taggedAttrs
                  );
                  mathSignatureValid = ok;
                  mathSignatureStatus = ok ? "VALID" : "INVALID";
                } else {
                  mathSignatureValid = false;
                  mathSignatureStatus = "INVALID";
                }
              } catch {
                mathSignatureValid = false;
                mathSignatureStatus = "INVALID";
              }
            }
          } else if (isRsa && matchedCert?.spkiBytes) {
            const rsaBits = matchedCert.rsaKeyBits;
            sigAlgorithmLabel = rsaBits ? `RSA PKCS#1 v1.5 (${rsaBits} bits)` : "RSA PKCS#1 v1.5";
            try {
              const pubKey = await crypto.subtle.importKey(
                "spki",
                matchedCert.spkiBytes,
                { name: "RSASSA-PKCS1-v1_5", hash: { name: signerInfo.digestAlgorithm } },
                false,
                ["verify"]
              );
              const ok = await crypto.subtle.verify(
                "RSASSA-PKCS1-v1_5",
                pubKey,
                signerInfo.sigBytes,
                signerInfo.taggedAttrs
              );
              mathSignatureValid = ok;
              mathSignatureStatus = ok ? "VALID" : "INVALID";
            } catch {
              mathSignatureValid = false;
              mathSignatureStatus = "INVALID";
            }
          } else {
            sigAlgorithmLabel = `Algoritmo ${sigAlgoOid || keyAlgoOid || "desconocido"}`;
            mathSignatureStatus = "UNSUPPORTED_ALGORITHM";
            mathSignatureValid = null;
          }
        }
      }

      const rsaKeyBits = matchedCert?.rsaKeyBits ?? null;
      const isWeakRsaKey = (rsaKeyBits !== null && rsaKeyBits < 2048);

      signatures.push({
        index: idx + 1,
        byteRange: [b0, l0, b1, l1],
        rangeValidBounds,
        gapIntegrityValid,
        isLatestSignature,
        isHistoricalRevision,
        isEnclosedBySubsequent,
        coversEntireFile,
        calculatedRangeHashHex,
        hashMatches,
        mathSignatureValid,
        mathSignatureStatus,
        sigAlgorithmLabel,
        certHashMatches,
        certSubstitutionDetected,
        hasMalformedEssCert,
        sidMatched,
        isSha1,
        rsaKeyBits,
        isWeakRsaKey,
        pdfMDate,
        matchedCert,
        signerInfo,
        cmsInfo
      });
    }

    return { fullDocHashHex, signatures };
  }

  // Referencias del DOM y renderizado de interfaz
  const dropzone = document.getElementById("validator-dropzone") as HTMLElement;
  const fileInput = document.getElementById("pdf-audit-input") as HTMLInputElement;
  const selectBtn = document.getElementById("select-pdf-btn") as HTMLButtonElement;
  const resultsPanel = document.getElementById("audit-results-panel") as HTMLElement;
  const filenameEl = document.getElementById("audit-filename") as HTMLElement;
  const filemetaEl = document.getElementById("audit-filemeta") as HTMLElement;
  const statusBanner = document.getElementById("audit-status-banner") as HTMLElement;
  const statusIcon = document.getElementById("audit-status-icon") as HTMLElement;
  const statusTitle = document.getElementById("audit-status-title") as HTMLElement;
  const statusDesc = document.getElementById("audit-status-desc") as HTMLElement;
  const signaturesList = document.getElementById("signatures-list") as HTMLElement;
  const resetBtn = document.getElementById("reset-audit-btn") as HTMLButtonElement;
  const printBtn = document.getElementById("print-audit-btn") as HTMLButtonElement;

  selectBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    fileInput?.click();
  });

  dropzone?.addEventListener("click", () => fileInput?.click());

  dropzone?.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropzone.classList.add("border-slate-500", "bg-slate-100/60");
  });

  dropzone?.addEventListener("dragleave", () => {
    dropzone.classList.remove("border-slate-500", "bg-slate-100/60");
  });

  dropzone?.addEventListener("drop", (e) => {
    e.preventDefault();
    dropzone.classList.remove("border-slate-500", "bg-slate-100/60");
    const file = e.dataTransfer?.files?.[0];
    if (file) handleFile(file);
  });

  fileInput?.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) handleFile(file);
  });

  resetBtn?.addEventListener("click", () => {
    resultsPanel.classList.add("hidden");
    dropzone.classList.remove("hidden");
    fileInput.value = "";
  });

  printBtn?.addEventListener("click", () => window.print());

  async function handleFile(file: File) {
    trackEvent('validator_pdf_loaded', {
      size_kb: Math.round(file.size / 1024),
    });

    dropzone.classList.add("hidden");
    resultsPanel.classList.remove("hidden");
    filenameEl.textContent = file.name;
    signaturesList.innerHTML = `<div class="p-6 text-center text-slate-500 text-sm">Inspeccionando estructuras ASN.1, calculando resúmenes criptográficos y verificando firmas...</div>`;

    try {
      const { fullDocHashHex, signatures } = await auditPdfBuffer(file);
      const sizeKb = (file.size / 1024).toFixed(1);
      filemetaEl.textContent = `${sizeKb} KB · SHA-256: ${fullDocHashHex.slice(0, 24)}...`;

      if (signatures.length === 0) {
        trackEvent('validator_success', {
          signature_count: 0,
          all_intact: false,
        });

        statusBanner.className = "mt-6 p-5 rounded-xl border bg-amber-50 border-amber-300 text-amber-900 flex items-start gap-4";
        statusIcon.innerHTML = `<svg class="w-7 h-7 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
        statusTitle.textContent = "Documento PDF Sin Firma Criptográfica";
        statusDesc.textContent = "No se han detectado estructuras PKCS#7 / CMS ni diccionarios /ByteRange en el código binario. Si el documento muestra un garabato o sello visual, se trata únicamente de una imagen pegada sin validez criptográfica.";
        signaturesList.innerHTML = "";
        return;
      }

      // Evaluación global del documento y sus firmas
      const hasCorruptedHash = signatures.some(s => !s.hashMatches);
      const hasFailedMath = signatures.some(s => s.mathSignatureStatus === "INVALID");
      const hasGapTampering = signatures.some(s => !s.gapIntegrityValid);
      const hasCertSubstitution = signatures.some(s => s.certSubstitutionDetected);
      const hasMalformedEssCert = signatures.some(s => s.hasMalformedEssCert);
      const hasUnsupportedAlgorithm = signatures.some(s => s.mathSignatureStatus === "UNSUPPORTED_ALGORITHM");
      const hasSha1 = signatures.some(s => s.isSha1);

      // Trailing data: solo si la ÚLTIMA firma no cubre el archivo completo
      const latestSig = signatures[signatures.length - 1];
      const hasTrailingData = (latestSig.byteRange[2] + latestSig.byteRange[3] < file.size);

      trackEvent('validator_success', {
        signature_count: signatures.length,
        all_intact: !hasCorruptedHash && !hasFailedMath && !hasGapTampering && !hasCertSubstitution && !hasMalformedEssCert && !hasTrailingData,
      });

      if (hasCorruptedHash || hasFailedMath || hasGapTampering || hasCertSubstitution || hasMalformedEssCert) {
        statusBanner.className = "mt-6 p-5 rounded-xl border bg-red-50 border-red-300 text-red-950 flex items-start gap-4";
        statusIcon.innerHTML = `<svg class="w-7 h-7 text-red-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;
        statusTitle.textContent = "Alerta: Integridad Criptográfica Comprometida o Manipulación Detectada";
        statusDesc.textContent = hasMalformedEssCert
          ? "Se ha detectado un atributo SigningCertificateV2 malformado en los atributos autenticados (la vinculación del certificado no es verificable)."
          : hasCertSubstitution
          ? "El certificado incluido en el documento no coincide con el hash firmado en el atributo SigningCertificateV2 (ESSCertIDv2)."
          : hasGapTampering
          ? "Se ha detectado contenido anómalo o inyección de operadores PDF dentro del gap de la firma (/ByteRange Wrapping Attack)."
          : hasCorruptedHash
          ? "El resumen criptográfico del archivo no coincide con el digest firmado. El documento fue alterado después de estampar la firma."
          : "La firma matemática no se corresponde con la clave pública contenida en el certificado del documento.";
      } else if (hasTrailingData) {
        statusBanner.className = "mt-6 p-5 rounded-xl border bg-red-50 border-red-300 text-red-950 flex items-start gap-4";
        statusIcon.innerHTML = `<svg class="w-7 h-7 text-red-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
        statusTitle.textContent = "Alerta: Modificación Posterior a la Última Firma (Rango Incompleto)";
        statusDesc.textContent = "La última firma del documento no cubre la totalidad del archivo PDF. Se han detectado revisiones o datos añadidos al final del archivo no amparados por ninguna firma digital válida.";
      } else if (hasUnsupportedAlgorithm) {
        const unsupportedList = signatures.filter(s => s.mathSignatureStatus === "UNSUPPORTED_ALGORITHM").map(s => s.sigAlgorithmLabel).join(", ");
        statusBanner.className = "mt-6 p-5 rounded-xl border bg-amber-50 border-amber-300 text-amber-950 flex items-start gap-4";
        statusIcon.innerHTML = `<svg class="w-7 h-7 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
        statusTitle.textContent = "Firma No Verificada: Algoritmo No Soportado Localmente";
        statusDesc.textContent = `El documento contiene firmas con algoritmo (${unsupportedList}) que no pueden ser verificadas localmente en este navegador. El resumen del documento es coherente, pero la firma matemática no pudo ser contrastada.`;
      } else if (hasSha1) {
        statusBanner.className = "mt-6 p-5 rounded-xl border bg-amber-50 border-amber-300 text-amber-950 flex items-start gap-4";
        statusIcon.innerHTML = `<svg class="w-7 h-7 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`;
        statusTitle.textContent = "Firma Criptográfica Íntegra con Algoritmo SHA-1 (Legado)";
        statusDesc.textContent = "La integridad matemática coincide con el archivo original, pero la firma utiliza el algoritmo hash SHA-1 (160 bits), en desuso y desaconsejado formalmente por el Esquema Nacional de Seguridad (ENS) y el reglamento eIDAS.";
      } else {
        // Estado Neutro Slate (Verificación Matemática Local comprobada, sin triunfalismo)
        statusBanner.className = "mt-6 p-5 rounded-xl border bg-slate-100 border-slate-300 text-slate-900 flex items-start gap-4";
        statusIcon.innerHTML = `<svg class="w-7 h-7 text-slate-700 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>`;
        statusTitle.textContent = `Análisis Local: Integridad de Bytes y Firma Matemática Coincidentes (${signatures.length} ${signatures.length === 1 ? "firma" : "firmas"})`;
        statusDesc.textContent = "La firma matemática y el resumen criptográfico coinciden con la clave pública y el certificado embebidos en el archivo. Estructura interna PDF (árbol de objetos y tabla xref) no analizada; este análisis se limita a la integridad de los rangos de bytes detectados.";
      }

      signaturesList.innerHTML = signatures.map((sig) => {
        const subj = sig.matchedCert?.subjectMap || sig.cmsInfo.subject;
        const iss = sig.matchedCert?.issuerMap || sig.cmsInfo.issuer;
        const signerName = subj.CN || `${subj.GN || ""} ${subj.SN || ""}`.trim() || "Certificado X.509 Embebido";
        const rawId = (subj.serialNumber || subj.organizationIdentifier || "").replace(/\b(VATES-|IDCES-)/gi, "").trim();
        const signerId = rawId || "No especificado en OID";
        const orgName = subj.O || "Persona Física / Particular";
        const issuerName = iss.CN || iss.O || "Autoridad de Certificación Declarada (CA)";

        const isSelfSignedVerified = (sig.matchedCert?.isSelfSignedSubjectIssuer && sig.matchedCert?.selfSignatureVerified === true);
        const caTrustStatus = isSelfSignedVerified
          ? "Autofirmado: ninguna autoridad respalda esta identidad"
          : "Emisor no verificado contra listas de confianza (LOTL/TSL) ni OCSP/CRL";

        const tzName = Intl.DateTimeFormat().resolvedOptions().timeZone || "hora local";

        const validRange = sig.matchedCert?.validFrom && sig.matchedCert?.validTo
          ? `${sig.matchedCert.validFrom.toLocaleDateString("es-ES")} (${sig.matchedCert.validFrom.toISOString().slice(0, 10)} UTC) → ${sig.matchedCert.validTo.toLocaleDateString("es-ES")} (${sig.matchedCert.validTo.toISOString().slice(0, 10)} UTC)`
          : "Declarada en estructura X.509";

        const isDocTimeStamp = sig.signerInfo?.isDocTimeStamp ?? false;
        const claimedDate = (sig.signerInfo?.signingTime) ? sig.signerInfo.signingTime : sig.pdfMDate;

        let dateRowTitle = "Fecha declarada por el firmante (sin sello de tiempo TSA)";
        let dateRowContent = "";

        if (isDocTimeStamp) {
          dateRowTitle = "Sello de Tiempo Certificado (RFC 3161 TSA)";
          const tstDateStr = claimedDate
            ? `${claimedDate.toLocaleString("es-ES")} (${tzName}) / ${claimedDate.toISOString().replace("T", " ").slice(0, 19)} UTC`
            : "Timestamp embebido";
          dateRowContent = `${tstDateStr} <span class="text-xs text-emerald-700 font-semibold block mt-0.5">✓ Sellado oficialmente por Autoridad de Sellado de Tiempo</span>`;
        } else if (claimedDate) {
          dateRowTitle = "Fecha declarada por el firmante (sin sello de tiempo TSA)";
          const claimedDateStr = `${claimedDate.toLocaleString("es-ES")} (${tzName}) / ${claimedDate.toISOString().replace("T", " ").slice(0, 19)} UTC`;
          const validFrom = sig.matchedCert?.validFrom;
          const validTo = sig.matchedCert?.validTo;
          let dateWarningHtml = "";
          if (validFrom && validTo) {
            const isWithinValidity = (claimedDate >= validFrom && claimedDate <= validTo);
            if (!isWithinValidity) {
              dateWarningHtml = `<span class="text-xs text-red-600 font-semibold block mt-1">⚠ La fecha declarada está fuera del periodo de validez del certificado (certificado no vigente en la fecha declarada)</span>`;
            } else {
              dateWarningHtml = `<span class="text-[11px] text-slate-400 block mt-0.5">Fecha dentro del periodo de vigencia del certificado</span>`;
            }
          }
          dateRowContent = `${claimedDateStr} <span class="text-xs text-slate-500 block">Vigencia del cert: ${validRange}</span>${dateWarningHtml}`;
        } else {
          dateRowTitle = "Fecha declarada por el firmante (sin sello de tiempo TSA)";
          dateRowContent = `Fecha no declarada en el archivo <span class="text-xs text-slate-500 block">Vigencia del cert: ${validRange}</span>`;
        }

        let badgeClass = "bg-slate-200 text-slate-800";
        let badgeLabel = "✓ Integridad Matemática Comprobada";

        if (sig.mathSignatureStatus === "INVALID" || !sig.hashMatches || !sig.gapIntegrityValid || sig.certSubstitutionDetected || sig.hasMalformedEssCert) {
          badgeClass = "bg-red-100 text-red-800";
          badgeLabel = sig.hasMalformedEssCert
            ? "✕ Atributo PAdES Malformado o No Verificable"
            : "✕ Firma Inválida o Manipulada";
        } else if (sig.mathSignatureStatus === "UNSUPPORTED_ALGORITHM") {
          badgeClass = "bg-amber-100 text-amber-800";
          badgeLabel = `⚠ Algoritmo No Soportado (${sig.sigAlgorithmLabel})`;
        } else if (sig.isSha1) {
          badgeClass = "bg-amber-100 text-amber-800";
          badgeLabel = "⚠ Algoritmo SHA-1 (Legado)";
        } else if (sig.isHistoricalRevision) {
          badgeClass = "bg-slate-200 text-slate-700";
          badgeLabel = "Cubierta por firma posterior (cambios entre revisiones no analizados)";
        }

        let mathResultText = "";
        if (sig.mathSignatureStatus === "VALID") {
          mathResultText = `✓ Válida (${sig.sigAlgorithmLabel})`;
        } else if (sig.mathSignatureStatus === "UNSUPPORTED_ALGORITHM") {
          mathResultText = `⚠ Algoritmo ${sig.sigAlgorithmLabel} no soportado localmente (Firma no verificada)`;
        } else {
          mathResultText = `✕ Fallo de verificación matemática (${sig.sigAlgorithmLabel})`;
        }
        if (sig.isWeakRsaKey) {
          mathResultText += `<span class="text-xs text-amber-700 font-semibold block mt-0.5">⚠ Clave RSA débil (${sig.rsaKeyBits} bits): estándar recomendado ≥ 2048 bits</span>`;
        }

        let coverageText = "";
        if (sig.isLatestSignature) {
          coverageText = `[${sig.byteRange.join(", ")}] (${sig.coversEntireFile ? "Cubre documento completo" : "⚠ Modificación posterior detectada"})`;
        } else {
          coverageText = `[${sig.byteRange.join(", ")}] (Revisión histórica amparada por firma #${sig.index + 1})`;
        }

        let padesBindingText = "";
        if (sig.signerInfo?.hasPadesEssCertIdV2) {
          if (sig.certSubstitutionDetected) {
            padesBindingText = "⚠ ALERTA: Discrepancia en ESSCertIDv2 (El certificado no coincide con el hash firmado)";
          } else if (sig.certHashMatches === true) {
            padesBindingText = "PAdES-B (ESSCertIDv2 verificado)";
          } else {
            padesBindingText = "PAdES (atributo SigningCertificateV2 malformado: vínculo con el certificado no verificable)";
          }
        } else {
          padesBindingText = "PKCS#7 Clásico (sin atributo ESSCertIDv2: vínculo con el certificado no verificable)";
        }

        return `
          <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-6 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-4 border-b border-slate-200">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-md bg-slate-900 text-white text-xs font-bold">Firma #${sig.index}</span>
                <span class="font-bold text-slate-900 text-base">Titular declarado: ${signerName}</span>
              </div>
              <span class="px-3 py-1 rounded-full text-xs font-bold ${badgeClass}">
                ${badgeLabel}
              </span>
            </div>

            <div class="grid md:grid-cols-2 gap-4 text-sm">
              <div class="bg-white p-3.5 rounded-lg border border-slate-200">
                <span class="text-xs text-slate-400 uppercase font-bold block">Identificador Declarado (NIF / NIE / CIF)</span>
                <span class="font-semibold text-slate-900">${signerId}</span>
                <span class="text-[11px] text-slate-400 block mt-0.5">Extraído del certificado del archivo (no contrastado externamente)</span>
              </div>
              <div class="bg-white p-3.5 rounded-lg border border-slate-200">
                <span class="text-xs text-slate-400 uppercase font-bold block">Organización / Entidad Declarada</span>
                <span class="font-semibold text-slate-900">${orgName}</span>
              </div>
              <div class="bg-white p-3.5 rounded-lg border border-slate-200">
                <span class="text-xs text-slate-400 uppercase font-bold block">Autoridad Emisora Declarada (CA)</span>
                <span class="font-semibold text-slate-900">${issuerName}</span>
                <span class="text-[11px] text-slate-500 block mt-0.5">${caTrustStatus}</span>
              </div>
              <div class="bg-white p-3.5 rounded-lg border border-slate-200">
                <span class="text-xs text-slate-400 uppercase font-bold block">${dateRowTitle}</span>
                <span class="font-semibold text-slate-900">${dateRowContent}</span>
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-200 grid md:grid-cols-3 gap-3 text-xs text-slate-600">
              <div>
                <strong class="text-slate-800 block">Cobertura /ByteRange:</strong>
                ${coverageText}
              </div>
              <div>
                <strong class="text-slate-800 block">Verificación Matemática:</strong>
                ${mathResultText}
              </div>
              <div class="break-all">
                <strong class="text-slate-800 block">Algoritmo (${sig.signerInfo?.digestAlgorithm || "N/A"}) y CertBinding:</strong>
                <code>${sig.signerInfo?.messageDigestHex ? sig.signerInfo.messageDigestHex.slice(0, 20) + "..." : "N/A"}</code>
                <span class="block text-slate-500 mt-0.5">${padesBindingText} · Gap: ${sig.gapIntegrityValid ? "OK" : "Manipulado"}</span>
              </div>
            </div>
          </div>
        `;
      }).join("");

    } catch (err: any) {
      trackEvent('validator_error', {
        error: err?.message || 'parse_failure',
      });
      statusBanner.className = "mt-6 p-5 rounded-xl border bg-red-50 border-red-300 text-red-900 flex items-start gap-4";
      statusTitle.textContent = "Error al leer el archivo PDF";
      statusDesc.textContent = "El archivo está dañado o protegido con contraseña de apertura.";
      signaturesList.innerHTML = "";
    }
  }
</script>
